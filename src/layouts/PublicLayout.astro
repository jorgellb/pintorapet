---
import '@/styles/global.css';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import VisitBeacon from '@/components/analytics/VisitBeacon.astro';
import CartDrawer from '@/components/shop/CartDrawer.astro';
import { t, type Locale } from '@/i18n';
import { alternatePath } from '@/i18n/routes';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Replaces the whole `<title>`, brand included. */
  seoTitle?: string | null;
  /** Absolute or root-relative image for link previews. */
  image?: string | null;
  /** Defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Same page in the other locale. Defaults to a translation of the current path. */
  alternatePath?: string;
  /** Open Graph type: 'product' on a product page. */
  ogType?: 'website' | 'product';
}

const {
  locale,
  title,
  description,
  seoTitle,
  image,
  canonicalPath,
  noindex = false,
  alternatePath: alternateOverride,
  ogType = 'website',
} = Astro.props;
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
// A coupon link (?cupon=) is for the visitor, not for the page's other-language address.
const otherParams = new URLSearchParams(Astro.url.search);
otherParams.delete('cupon');
otherParams.delete('coupon');
const otherSearch = otherParams.size ? `?${otherParams}` : '';
const alternateHref =
  alternateOverride ?? `${alternatePath(Astro.url.pathname, otherLocale)}${otherSearch}`;
const dict = t(locale);
const siteTitle = seoTitle?.trim() || `${title} · ${dict.brand.name}`;
const origin = Astro.site ?? 'https://petsdrawings.com';
const canonical = new URL(canonicalPath ?? Astro.url.pathname, origin).href;
const ogImage = image ? new URL(image, origin).href : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{siteTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={dict.brand.name} />
    <meta property="og:title" content={siteTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale} href={new URL(alternateHref, origin).href} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>
    <SiteHeader locale={locale} alternateHref={alternateHref} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <CartDrawer locale={locale} />
    <VisitBeacon locale={locale} />
  </body>
</html>

<script>
  import { initCouponLink } from '@/scripts/couponLink';

  initCouponLink();
</script>

<style is:global>
  /* The note after a coupon link: a small paper slip over the corner of the page. */
  .coupon-note {
    position: fixed;
    z-index: 200;
    left: 1rem;
    right: 1rem;
    top: 0.75rem;
    margin: 0 auto;
    max-width: 26rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.6rem 0.7rem 1rem;
    background: var(--sheet);
    border-left: 3px solid var(--accent);
    box-shadow: var(--shadow-art);
    font-size: 0.92rem;
    color: var(--ink);
  }

  .coupon-note__close {
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }

  .coupon-note__close:hover {
    color: var(--ink);
  }
</style>
