---
import { t, fill, type Locale } from '@/i18n';

interface Props {
  /** 0–5; a fraction fills part of a star (an average). */
  rating: number;
  locale: Locale;
  /** Height in rem. */
  size?: number;
}

const { rating, locale, size = 1 } = Astro.props;
const value = Math.min(5, Math.max(0, rating));
const shown = Number.isInteger(value) ? String(value) : value.toFixed(1).replace(/\.0$/, '');
const label = fill(t(locale).reviews.stars, { n: locale === 'es' ? shown.replace('.', ',') : shown });

// Five stars 12 wide with a 2 gap; the filled copy is clipped by a nested <svg>.
const STAR = 'M6 .7l1.7 3.6 3.9.5-2.9 2.7.8 3.9L6 9.4 2.5 11.4l.8-3.9L.4 4.8l3.9-.5z';
const starAt = (i: number) => `translate(${i * 14} 0)`;
const filled = Math.floor(value) * 14 + (value % 1) * 12;
---

<svg
  class="stars"
  viewBox="0 0 68 12"
  role="img"
  aria-label={label}
  lang={locale}
  style={`height:${size}rem;width:${(size * 68) / 12}rem`}
>
  <g class="stars__empty">
    {[0, 1, 2, 3, 4].map((i) => <path d={STAR} transform={starAt(i)}></path>)}
  </g>
  {
    filled > 0 && (
      <svg class="stars__on" width={filled} height="12" viewBox={`0 0 ${filled} 12`}>
        {[0, 1, 2, 3, 4].map((i) => <path d={STAR} transform={starAt(i)}></path>)}
      </svg>
    )
  }
</svg>

<style>
  .stars {
    display: inline-block;
    flex: none;
    vertical-align: middle;
    overflow: visible;
  }

  .stars__empty path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 0.8;
    stroke-linejoin: round;
  }

  .stars__on path {
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
</style>
