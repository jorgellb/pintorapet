---
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
---

<aside class="cookie-note" data-analytics-note aria-label={es ? 'Cookies' : 'Cookies'}>
  <p>
    {es ? 'Medición anónima de visitas.' : 'Anonymous visit measurement.'}
    <a href={es ? '/es/cookies/' : '/en/cookies/'}>{es ? 'Detalle' : 'Details'}</a>
  </p>
  <div class="cookie-note__actions">
    <button type="button" data-analytics-no>{es ? 'Rechazar' : 'Decline'}</button>
    <button type="button" data-analytics-yes>{es ? 'Aceptar' : 'Accept'}</button>
  </div>
</aside>

<style>
  .cookie-note {
    position: fixed;
    z-index: 80;
    right: 1.25rem;
    bottom: 1.25rem;
    display: none;
    width: min(18.5rem, calc(100vw - 2rem));
    padding: 0.85rem 0.95rem 0.8rem;
    background: rgb(250 250 248 / 0.94);
    color: var(--ink, #16171a);
    border: 1px solid var(--line, #e2e2dd);
    border-radius: 2px;
    box-shadow: 0 10px 30px rgb(22 23 26 / 0.06);
    backdrop-filter: blur(8px);
    pointer-events: auto;
  }

  .cookie-note.is-open {
    display: grid;
    gap: 0.7rem;
  }

  .cookie-note p {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  .cookie-note a {
    color: inherit;
    margin-left: 0.25rem;
  }

  .cookie-note__actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .cookie-note button {
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    padding: 0.38rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
  }

  .cookie-note [data-analytics-no] {
    background: transparent;
    color: var(--ink-soft, #3a3d44);
    border: 1px solid var(--line-strong, #c9c9c3);
  }

  .cookie-note [data-analytics-yes] {
    background: var(--ink, #16171a);
    color: var(--paper, #fafaf8);
    border: 1px solid var(--ink, #16171a);
  }
</style>

<script>
  const choiceKey = 'pd-analytics';
  const sessionKey = 'pd-visit';

  const send = () => {
    let sessionId = sessionStorage.getItem(sessionKey);
    if (!sessionId) {
      sessionId = crypto.randomUUID();
      sessionStorage.setItem(sessionKey, sessionId);
    }
    const params = new URLSearchParams(location.search);
    fetch('/api/analytics/collect/', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        sessionId,
        path: location.pathname,
        locale: document.documentElement.lang,
        referrer: document.referrer,
        language: navigator.language,
        viewport: `${window.innerWidth}x${window.innerHeight}`,
        utmSource: params.get('utm_source'),
        utmMedium: params.get('utm_medium'),
        utmCampaign: params.get('utm_campaign'),
      }),
      keepalive: true,
    }).catch(() => undefined);
  };

  const open = () => document.querySelector('[data-analytics-note]')?.classList.add('is-open');
  const close = () => document.querySelector('[data-analytics-note]')?.classList.remove('is-open');

  const choice = localStorage.getItem(choiceKey);
  if (choice === 'yes') send();
  else if (!choice) open();

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('[data-analytics-yes]')) {
      localStorage.setItem(choiceKey, 'yes');
      close();
      send();
    } else if (target.closest('[data-analytics-no]')) {
      localStorage.setItem(choiceKey, 'no');
      close();
    }
  });
</script>
