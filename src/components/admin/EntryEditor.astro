---
import MediaPicker from '@/components/admin/MediaPicker.astro';
import SeoFields from '@/components/admin/SeoFields.astro';
import { galleryGroupLabel, workCategoryLabel } from '@/lib/admin/labels';
import { mediaDisplayName } from '@/lib/admin/mediaPicker';
import { siteUrl } from '@/lib/server/env';
import { resolveMediaUrl } from '@/lib/server/storageUrl';

interface MediaOption {
  id: string;
  publicUrl: string;
  object_path: string;
  bucket: string;
  altEs: string;
  altEn: string;
}

interface AssetValue {
  role: string;
  src: string;
  label?: string | null;
  altEn?: string;
  altEs?: string;
  mediaId?: string | null;
}

interface Props {
  kind: 'work' | 'gallery';
  mode: 'create' | 'edit';
  id?: string;
  media: MediaOption[];
  values: {
    legacyId?: string | null;
    slugEn?: string;
    slugEs?: string;
    category?: string;
    group?: string;
    titleEn: string;
    titleEs: string;
    summaryEn?: string;
    summaryEs?: string;
    storyEn?: string;
    storyEs?: string;
    seoTitleEn?: string | null;
    seoTitleEs?: string | null;
    seoDescriptionEn?: string | null;
    seoDescriptionEs?: string | null;
    sortOrder: number;
    published: boolean;
    assets: AssetValue[];
  };
}

const { kind, mode, id, media, values } = Astro.props;
const work = kind === 'work';
const roleLabels: Record<string, string> = {
  drawing: 'Dibujo',
  reference_photo: 'Foto de referencia',
  comparison: 'Comparación',
  process_photo: 'Proceso',
  related_product_photo: 'Producto relacionado',
  other: 'Otra',
};
const roles = work
  ? ['drawing', 'reference_photo', 'comparison', 'process_photo', 'related_product_photo']
  : ['drawing', 'reference_photo', 'other'];
const categories = ['dog', 'cat', 'horse', 'people', 'other'];
const groups = ['people', 'architecture', 'illustration', 'other'];
const base = work ? '/api/admin/artworks/' : '/api/admin/gallery/';
const endpoint = mode === 'create' ? base : `${base}${id}/`;
const back = work ? '/admin/work/' : '/admin/gallery/';
const publicUrl = work && mode === 'edit' && values.slugEs ? `/es/obra/${values.slugEs}/` : null;
const blankAsset: AssetValue = { role: 'drawing', src: '' };
const mediaById = new Map(media.map((item) => [item.id, item]));
const pickerItems = media.map((item) => ({
  id: item.id,
  url: item.publicUrl,
  name: mediaDisplayName(item.object_path),
  bucket: item.bucket,
  altEs: item.altEs,
  altEn: item.altEn,
}));
// New rows: the first image is the cover, the rest default to process / other.
const nextRole = work ? 'process_photo' : 'other';
const host = siteUrl().replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<form
  class="editor"
  data-entry-form
  data-endpoint={endpoint}
  data-method={mode === 'create' ? 'POST' : 'PATCH'}
  data-back={back}
>
  <div class="editor-main">
    <fieldset>
      <legend>Textos</legend>
      <div class="pair">
        <label>
          Título
          <input name="titleEs" value={values.titleEs} required />
        </label>
        <label>
          Título en inglés
          <input name="titleEn" value={values.titleEn} required />
        </label>
      </div>
      <div class="pair">
        <label>
          Descripción
          <textarea name="summaryEs" rows="4">{values.summaryEs ?? ''}</textarea>
        </label>
        <label>
          Descripción en inglés
          <textarea name="summaryEn" rows="4">{values.summaryEn ?? ''}</textarea>
        </label>
      </div>
      <div class="pair">
        <label>
          Proceso de trabajo
          <textarea name="storyEs" rows="6">{values.storyEs ?? ''}</textarea>
        </label>
        <label>
          Proceso de trabajo en inglés
          <textarea name="storyEn" rows="6">{values.storyEn ?? ''}</textarea>
        </label>
      </div>
    </fieldset>

    {
      work && (
        <fieldset>
          <legend>SEO</legend>
          <p class="hint">
            Así aparece la ficha en Google y al compartirla. Si dejas los campos vacíos se usan
            el título y la descripción.
          </p>
          <div class="pair seo-pair">
            <SeoFields
              language="Español"
              host={host}
              pathPrefix="/es/obra/"
              slugName="slugEs"
              slug={values.slugEs ?? ''}
              titleName="seoTitleEs"
              descriptionName="seoDescriptionEs"
              seoTitle={values.seoTitleEs ?? ''}
              seoDescription={values.seoDescriptionEs ?? ''}
              fallbackTitleName="titleEs"
              fallbackDescriptionName="summaryEs"
              fallbackDescriptionLabel="la descripción"
            />
            <SeoFields
              language="Inglés"
              host={host}
              pathPrefix="/en/work/"
              slugName="slugEn"
              slug={values.slugEn ?? ''}
              titleName="seoTitleEn"
              descriptionName="seoDescriptionEn"
              seoTitle={values.seoTitleEn ?? ''}
              seoDescription={values.seoDescriptionEn ?? ''}
              fallbackTitleName="titleEn"
              fallbackDescriptionName="summaryEn"
              fallbackDescriptionLabel="la descripción"
            />
          </div>
        </fieldset>
      )
    }

    <fieldset>
      <legend>Imágenes</legend>
      <p class="hint">
        Elige las imágenes de <a href="/admin/media/" target="_blank" rel="noreferrer">Medios</a> o súbelas
        aquí: se guardan en Medios. La primera con papel «Dibujo» es la portada; pulsa una imagen para
        cambiarla.
      </p>
      <div class="assets" data-assets data-next-role={nextRole}>
        {
          [...values.assets, null].map((asset) => {
            const value = asset ?? blankAsset;
            const linked = value.mediaId ? mediaById.get(value.mediaId) : undefined;
            const thumb = linked?.publicUrl ?? (resolveMediaUrl(value.src) || undefined);
            const row = (
              <div class="asset" data-asset-row>
                <button type="button" class="asset-image" data-choose title="Cambiar imagen desde Medios">
                  <img src={thumb} alt="" data-thumb />
                  <span class="asset-image__hint">Cambiar</span>
                </button>
                <div class="asset-fields">
                  <input type="hidden" name="mediaId" value={value.mediaId ?? ''} />
                  <p class="asset-file" data-file-name>
                    {linked ? mediaDisplayName(linked.object_path) : value.src ? 'Imagen con ruta manual' : 'Sin imagen'}
                  </p>
                  <div class="pair">
                    <label>
                      Papel
                      <select name="role">
                        {roles.map((role) => (
                          <option value={role} selected={value.role === role}>
                            {roleLabels[role] ?? role}
                          </option>
                        ))}
                      </select>
                    </label>
                    {work && (
                      <label>
                        Etiqueta
                        <input name="label" value={value.label ?? ''} placeholder="Ej.: Antes, Después" />
                      </label>
                    )}
                  </div>
                  <div class="pair">
                    <label>
                      Texto alternativo
                      <input name="altEs" value={value.altEs ?? ''} />
                    </label>
                    <label>
                      Texto alternativo en inglés
                      <input name="altEn" value={value.altEn ?? ''} />
                    </label>
                  </div>
                  <details class="manual" open={!value.mediaId && Boolean(value.src)}>
                    <summary>Ruta manual</summary>
                    <label>
                      Ruta o URL
                      <input name="src" value={value.src} data-src placeholder="/media/portfolio/…" />
                      <span class="hint">Solo para imágenes que no están en Medios.</span>
                    </label>
                  </details>
                  <div class="asset-actions">
                    <button type="button" class="btn--quiet" data-up aria-label="Subir imagen">↑</button>
                    <button type="button" class="btn--quiet" data-down aria-label="Bajar imagen">↓</button>
                    <button type="button" class="btn--quiet btn--danger" data-remove>Quitar</button>
                  </div>
                </div>
              </div>
            );
            return asset ? row : <template data-asset-template>{row}</template>;
          })
        }
      </div>
      <div class="drop" data-drop>
        <p>Arrastra imágenes aquí o</p>
        <div class="drop-actions">
          <button type="button" data-add>Añadir desde Medios</button>
          <label class="btn btn--quiet">
            Subir del ordenador
            <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden data-upload />
          </label>
        </div>
        <p class="status" data-upload-status role="status" hidden></p>
      </div>
    </fieldset>
  </div>

  <aside class="editor-side">
    <div class="panel">
      <label class="switch">
        <input type="checkbox" role="switch" name="published" checked={values.published} />
        <span>
          <strong>Publicada</strong>
          <span class="hint">Visible en la web.</span>
        </span>
      </label>
      {
        work ? (
          <label>
            Categoría
            <select name="category">
              {categories.map((item) => (
                <option value={item} selected={values.category === item}>
                  {workCategoryLabel(item)}
                </option>
              ))}
            </select>
          </label>
        ) : (
          <label>
            Grupo
            <select name="group">
              {groups.map((item) => (
                <option value={item} selected={values.group === item}>
                  {galleryGroupLabel(item)}
                </option>
              ))}
            </select>
          </label>
        )
      }
      <label>
        Orden
        <input type="number" name="sortOrder" min="0" step="1" value={values.sortOrder} required />
        <span class="hint">Los números bajos salen primero.</span>
      </label>
      <button type="submit">{mode === 'create' ? 'Crear' : 'Guardar cambios'}</button>
      <p class="status" data-status role="status" hidden></p>
      {publicUrl && (
        <a class="hint" href={publicUrl} target="_blank" rel="noreferrer">
          Ver en la web ↗
        </a>
      )}
    </div>
  </aside>
</form>

<MediaPicker items={pickerItems} defaultBucket="portfolio-public" />

<style>
  .assets {
    display: grid;
    gap: 0.75rem;
  }

  .asset {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--a-radius);
    background: var(--paper);
  }

  .asset-image {
    position: relative;
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    min-height: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--paper-deep);
  }

  .asset-image:hover,
  .asset-image:focus-visible {
    border-color: var(--accent);
    background: var(--paper-deep);
  }

  .asset-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .asset-image img:not([src]) {
    visibility: hidden;
  }

  .asset-image__hint {
    position: absolute;
    inset: auto 0 0;
    padding: 0.2rem;
    background: rgb(22 23 26 / 0.6);
    color: #fff;
    font-size: 0.72rem;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .asset-image:hover .asset-image__hint,
  .asset-image:focus-visible .asset-image__hint,
  .asset-image:has(img:not([src])) .asset-image__hint {
    opacity: 1;
  }

  .asset-file {
    margin: 0;
    overflow: hidden;
    font-size: 0.85rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .manual summary {
    width: fit-content;
    color: var(--muted);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .manual label {
    margin-top: 0.5rem;
  }

  .drop {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding: 1.25rem;
    border: 2px dashed var(--line-strong, var(--line));
    border-radius: var(--a-radius);
    text-align: center;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .drop p {
    margin: 0;
    color: var(--muted);
  }

  .drop.is-over {
    border-color: var(--accent);
    background: var(--accent-soft, var(--paper));
  }

  .drop-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .drop-actions .btn {
    cursor: pointer;
  }

  .asset-fields {
    display: grid;
    gap: 0.7rem;
  }

  .asset-actions {
    display: flex;
    gap: 0.4rem;
  }

  .asset-actions button {
    min-height: 2rem;
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
  }

  .asset:first-of-type [data-up],
  .asset:last-of-type [data-down] {
    visibility: hidden;
  }

  .seo-pair {
    align-items: start;
    gap: 1.5rem;
  }

  @media (max-width: 40rem) {
    .asset {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { pickMedia, uploadToMedia, type PickedMedia } from '@/lib/admin/mediaPicker';

  const form = document.querySelector('[data-entry-form]');
  if (form instanceof HTMLFormElement) {
    const assets = form.querySelector<HTMLElement>('[data-assets]');
    const template = form.querySelector('[data-asset-template]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const say = (text: string) => {
      if (!status) return;
      status.hidden = false;
      status.textContent = text;
    };

    const field = (row: Element, name: string) => row.querySelector<HTMLInputElement>(`[name="${name}"]`);

    /** Put a Medios image in a row; texts left empty take the ones from Medios. */
    const fill = (row: HTMLElement, item: PickedMedia) => {
      const mediaId = field(row, 'mediaId');
      const src = field(row, 'src');
      if (mediaId) mediaId.value = item.id;
      if (src) src.value = item.url;
      const thumb = row.querySelector<HTMLImageElement>('[data-thumb]');
      if (thumb) thumb.src = item.url;
      const name = row.querySelector('[data-file-name]');
      if (name) name.textContent = item.name;
      const altEs = field(row, 'altEs');
      const altEn = field(row, 'altEn');
      if (altEs && !altEs.value.trim()) altEs.value = item.altEs;
      if (altEn && !altEn.value.trim()) altEn.value = item.altEn;
      row.querySelector('details.manual')?.removeAttribute('open');
    };

    const ids = () =>
      [...(assets?.querySelectorAll<HTMLInputElement>('[data-asset-row] [name="mediaId"]') ?? [])]
        .map((input) => input.value)
        .filter(Boolean);

    const wire = (row: HTMLElement) => {
      const src = field(row, 'src');
      const thumb = row.querySelector<HTMLImageElement>('[data-thumb]');
      row.querySelector('[data-choose]')?.addEventListener('click', async () => {
        const [item] = await pickMedia({ bucket: 'portfolio-public' });
        if (item) fill(row, item);
      });
      // A typed path replaces the Medios link.
      src?.addEventListener('change', () => {
        const mediaId = field(row, 'mediaId');
        if (mediaId) mediaId.value = '';
        const name = row.querySelector('[data-file-name]');
        if (name) name.textContent = src.value ? 'Imagen con ruta manual' : 'Sin imagen';
        if (!thumb) return;
        if (src.value) thumb.src = src.value;
        else thumb.removeAttribute('src');
      });
      row.querySelector('[data-remove]')?.addEventListener('click', () => row.remove());
      row.querySelector('[data-up]')?.addEventListener('click', () => {
        const prev = row.previousElementSibling;
        if (prev?.matches('[data-asset-row]')) prev.before(row);
      });
      row.querySelector('[data-down]')?.addEventListener('click', () => {
        const next = row.nextElementSibling;
        if (next?.matches('[data-asset-row]')) next.after(row);
      });
    };

    /** A new row for an image; the first drawing is the cover, the rest get the usual role. */
    const addRow = (item: PickedMedia) => {
      if (!(template instanceof HTMLTemplateElement) || !assets) return;
      const row = template.content.firstElementChild?.cloneNode(true);
      if (!(row instanceof HTMLElement)) return;
      const hasDrawing = [...assets.querySelectorAll<HTMLSelectElement>('[data-asset-row] [name="role"]')].some(
        (select) => select.value === 'drawing',
      );
      const role = row.querySelector<HTMLSelectElement>('[name="role"]');
      if (role) role.value = hasDrawing ? (assets.dataset.nextRole ?? 'other') : 'drawing';
      template.before(row);
      wire(row);
      fill(row, item);
    };

    assets?.querySelectorAll<HTMLElement>('[data-asset-row]').forEach(wire);

    form.querySelector('[data-add]')?.addEventListener('click', async () => {
      const picked = await pickMedia({ multiple: true, bucket: 'portfolio-public', exclude: ids() });
      picked.forEach(addRow);
    });

    // Upload from the computer (button or drop): each file goes to Medios, then into a row.
    const drop = form.querySelector<HTMLElement>('[data-drop]');
    const uploadStatus = form.querySelector<HTMLElement>('[data-upload-status]');
    const upload = async (files: File[]) => {
      const images = files.filter((file) => /^image\/(jpeg|png|webp|gif)$/.test(file.type));
      if (images.length === 0) return;
      if (uploadStatus) uploadStatus.hidden = false;
      for (const [index, file] of images.entries()) {
        if (uploadStatus) uploadStatus.textContent = `Subiendo ${index + 1} de ${images.length}…`;
        try {
          addRow(await uploadToMedia(file, 'portfolio-public'));
        } catch (err) {
          if (uploadStatus) uploadStatus.textContent = err instanceof Error ? err.message : 'No se pudo subir.';
          return;
        }
      }
      if (uploadStatus) {
        uploadStatus.textContent =
          images.length === 1 ? 'Imagen subida a Medios.' : `${images.length} imágenes subidas a Medios.`;
      }
    };
    form.querySelector<HTMLInputElement>('[data-upload]')?.addEventListener('change', (event) => {
      const input = event.currentTarget as HTMLInputElement;
      upload([...(input.files ?? [])]).finally(() => (input.value = ''));
    });
    drop?.addEventListener('dragover', (event) => {
      event.preventDefault();
      drop.classList.add('is-over');
    });
    drop?.addEventListener('dragleave', () => drop.classList.remove('is-over'));
    drop?.addEventListener('drop', (event) => {
      event.preventDefault();
      drop.classList.remove('is-over');
      upload([...(event.dataTransfer?.files ?? [])]);
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === 's') {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const read = (name: string) => {
        const field = form.elements.namedItem(name);
        return field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement
          ? field.value
          : '';
      };
      const published = form.elements.namedItem('published');
      const payload: Record<string, unknown> = {
        titleEn: read('titleEn'),
        titleEs: read('titleEs'),
        summaryEn: read('summaryEn'),
        summaryEs: read('summaryEs'),
        storyEn: read('storyEn'),
        storyEs: read('storyEs'),
        sortOrder: Number(read('sortOrder') || 0),
        published: published instanceof HTMLInputElement ? published.checked : false,
        assets: [...(assets?.querySelectorAll('[data-asset-row]') ?? [])].map((row) => {
          const value = (name: string) => {
            const field = row.querySelector(`[name="${name}"]`);
            return field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value : '';
          };
          return {
            role: value('role'),
            src: value('src'),
            label: value('label') || null,
            altEn: value('altEn'),
            altEs: value('altEs'),
            mediaId: value('mediaId') || null,
          };
        }),
      };
      if (form.querySelector('[name="category"]')) {
        payload.category = read('category');
        payload.slugEn = read('slugEn');
        payload.slugEs = read('slugEs');
        payload.seoTitleEn = read('seoTitleEn');
        payload.seoTitleEs = read('seoTitleEs');
        payload.seoDescriptionEn = read('seoDescriptionEn');
        payload.seoDescriptionEs = read('seoDescriptionEs');
      } else {
        payload.group = read('group');
      }
      if ((payload.assets as Array<{ src: string }>).some((asset) => !asset.src.trim())) {
        say('Cada imagen necesita un archivo de Medios o una ruta. Elige una o quita la fila.');
        return;
      }
      say('Guardando…');
      const response = await fetch(form.dataset.endpoint ?? '', {
        method: form.dataset.method ?? 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      }).catch(() => null);
      const body = (await response?.json().catch(() => null)) as { id?: string; error?: { message?: string } } | null;
      if (!response?.ok) {
        say(body?.error?.message ?? 'No se pudo guardar.');
        return;
      }
      if (form.dataset.method === 'POST' && body?.id) {
        window.location.href = `${form.dataset.back}${body.id}/`;
        return;
      }
      say('Cambios guardados.');
    });
  }
</script>
