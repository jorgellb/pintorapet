---
import TypeIcon from '@/components/shop/TypeIcon.astro';
import { TYPE_ICONS, phraseOf, type TypeIcon as Icon } from '@/lib/catalog/productTypes';
import type { AdminProductType } from '@/lib/server/admin/productTypes';

/** Create or edit a product type (Admin › Tienda › Tipos de producto). */
interface Props {
  type?: AdminProductType;
}

const { type } = Astro.props;
const creating = !type;

const iconNames: Record<Icon, string> = {
  card: 'Tarjeta',
  coaster: 'Posavasos',
  mug: 'Taza',
  ornament: 'Bola',
  keyring: 'Llavero',
  print: 'Lámina',
  bag: 'Bolsa',
  tag: 'Etiqueta',
};
const vatRates = [
  { value: 21, label: '21 % · general' },
  { value: 10, label: '10 % · reducido' },
  { value: 4, label: '4 % · superreducido' },
  { value: 0, label: '0 % · exento' },
];
---

<form class="type-form" data-type-form data-id={type?.id ?? ''} novalidate>
  <section class="panel">
    <h2>Nombre</h2>
    <div class="pair">
      <label>
        En plural
        <input name="nameEs" value={type?.nameEs ?? ''} required maxlength="60" placeholder="Ej.: Láminas" data-name />
      </label>
      <label>
        En plural, en inglés
        <input name="nameEn" value={type?.nameEn ?? ''} required maxlength="60" placeholder="Ej.: Prints" />
      </label>
    </div>
    <p class="hint">El botón del filtro en la tienda y la pestaña en Productos.</p>
    <div class="pair">
      <label>
        En singular
        <input name="singularEs" value={type?.singularEs ?? ''} required maxlength="60" placeholder="Ej.: Lámina" data-singular="phraseEs" />
      </label>
      <label>
        En singular, en inglés
        <input name="singularEn" value={type?.singularEn ?? ''} required maxlength="60" placeholder="Ej.: Print" data-singular="phraseEn" />
      </label>
    </div>
    <p class="hint">En la etiqueta del precio y en la fila de cada retrato.</p>
    <div class="pair">
      <label>
        Dentro de una frase <span class="hint">opcional</span>
        <input name="phraseEs" value={type?.phraseEs ?? ''} maxlength="60" placeholder={phraseOf(type?.singularEs || 'Lámina', '')} />
      </label>
      <label>
        Dentro de una frase, en inglés <span class="hint">opcional</span>
        <input name="phraseEn" value={type?.phraseEn ?? ''} maxlength="60" placeholder={phraseOf(type?.singularEn || 'Print', '')} />
      </label>
    </div>
    <p class="hint">
      Para «Un retrato de Meili, en tarjeta, taza y <em>lámina</em>». Vacío, se usa lo que ves en gris: el singular
      empezando en minúscula. Escríbelo solo si debe llevar mayúscula (Christmas ornament).
    </p>
    {
      creating ? (
        <label>
          Dirección
          <input
            name="code"
            required
            maxlength="60"
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            placeholder="laminas"
            data-code
          />
          <span class="hint">
            Enlace directo al filtro: <code>/es/tienda/?category=<span data-code-preview>laminas</span></code>. Solo
            minúsculas, números y guiones. No se puede cambiar después.
          </span>
        </label>
      ) : (
        <p class="hint">
          Dirección: <code>/es/tienda/?category={type.code}</code>
        </p>
      )
    }
  </section>

  <section class="panel">
    <h2>Icono</h2>
    <p class="hint">Acompaña al nombre en el filtro de la tienda.</p>
    <div class="icons" role="radiogroup" aria-label="Icono">
      {
        TYPE_ICONS.map((icon) => (
          <label class="icon-choice">
            <input type="radio" name="icon" value={icon} checked={(type?.icon ?? 'tag') === icon} />
            <TypeIcon icon={icon} />
            <span>{iconNames[icon]}</span>
          </label>
        ))
      }
    </div>
  </section>

  <section class="panel">
    <h2>Productos nuevos</h2>
    <p class="hint">
      Con qué peso e IVA empiezan los productos que crees de este tipo. Los que ya existen conservan los suyos; cámbialos
      en cada ficha.
    </p>
    <div class="pair">
      <label>
        Peso (gramos)
        <input
          name="defaultWeightGrams"
          type="number"
          inputmode="numeric"
          min="1"
          max="30000"
          step="1"
          value={type?.defaultWeightGrams ?? 100}
          required
        />
        <span class="hint">Con su embalaje. Cuenta para el precio del envío.</span>
      </label>
      <label>
        IVA
        <select name="vatRate">
          {vatRates.map((rate) => <option value={rate.value} selected={(type?.vatRate ?? 21) === rate.value}>{rate.label}</option>)}
        </select>
      </label>
    </div>
  </section>

  <section class="panel">
    <h2>Catálogos de Google y Meta</h2>
    <label>
      Categoría de Google <span class="hint">opcional</span>
      <input
        name="googleCategory"
        value={type?.googleCategory ?? ''}
        maxlength="250"
        placeholder="Home & Garden > Decor > Artwork > Posters, Prints, & Visual Artwork"
      />
      <span class="hint">
        De la lista de categorías de Google, en inglés. Ayuda a que los anuncios salgan en las búsquedas adecuadas.
      </span>
    </label>
  </section>

  <section class="panel">
    <label class="switch">
      <input type="checkbox" role="switch" name="published" checked={type ? type.published : true} />
      <span>
        <strong>Visible en la tienda</strong>
        <span class="hint">
          Oculto, el filtro y sus productos salen de la tienda y de los catálogos de Google y Meta; sus fichas siguen
          existiendo. Útil para las piezas de temporada.
        </span>
      </span>
    </label>
  </section>

  <div class="actions">
    <button type="submit">{creating ? 'Crear tipo' : 'Guardar cambios'}</button>
    <p class="status" data-type-status role="status" hidden></p>
  </div>
</form>

<style>
  .type-form {
    display: grid;
    gap: 1.25rem;
  }

  .icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .icon-choice {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    min-width: 5.5rem;
    padding: 0.75rem 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--a-radius-sm);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .icon-choice :global(.type-icon) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .icon-choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .icon-choice:has(input:checked) {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .icon-choice:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-type-form]');
  if (form) {
    const id = form.dataset.id ?? '';
    const status = form.querySelector<HTMLElement>('[data-type-status]')!;
    const say = (text: string) => {
      status.hidden = false;
      status.textContent = text;
    };
    const value = (name: string) =>
      ((form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '').trim();

    // A new type's address follows its name until it is typed by hand.
    const code = form.querySelector<HTMLInputElement>('[data-code]');
    const preview = form.querySelector<HTMLElement>('[data-code-preview]');
    const slug = (text: string) =>
      text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '')
        .slice(0, 60);
    const showCode = () => {
      if (preview && code) preview.textContent = code.value || 'laminas';
    };
    form.querySelector<HTMLInputElement>('[data-name]')?.addEventListener('input', (event) => {
      if (!code || code.dataset.touched) return;
      code.value = slug((event.currentTarget as HTMLInputElement).value);
      showCode();
    });
    code?.addEventListener('input', () => {
      code.dataset.touched = '1';
      showCode();
    });

    // The phrase's grey hint shows what an empty phrase becomes.
    form.querySelectorAll<HTMLInputElement>('[data-singular]').forEach((singular) =>
      singular.addEventListener('input', () => {
        const phrase = form.elements.namedItem(singular.dataset.singular!) as HTMLInputElement;
        const text = singular.value.trim();
        phrase.placeholder = text ? text.charAt(0).toLowerCase() + text.slice(1) : '';
      }),
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body: Record<string, unknown> = {
        nameEs: value('nameEs'),
        nameEn: value('nameEn'),
        singularEs: value('singularEs'),
        singularEn: value('singularEn'),
        phraseEs: value('phraseEs'),
        phraseEn: value('phraseEn'),
        icon: form.querySelector<HTMLInputElement>('input[name="icon"]:checked')?.value ?? 'tag',
        defaultWeightGrams: Number(value('defaultWeightGrams')),
        vatRate: Number(value('vatRate')),
        googleCategory: value('googleCategory'),
        published: (form.elements.namedItem('published') as HTMLInputElement).checked,
      };
      if (!body.nameEs || !body.nameEn || !body.singularEs || !body.singularEn) {
        return say('Escribe el nombre en plural y en singular, en los dos idiomas.');
      }
      const weight = body.defaultWeightGrams as number;
      if (!Number.isInteger(weight) || weight < 1 || weight > 30000) {
        return say('El peso va en gramos, sin decimales, entre 1 y 30 000.');
      }
      if (code) {
        body.code = code.value.trim();
        if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(String(body.code))) {
          return say('La dirección solo puede llevar minúsculas, números y guiones (sin tildes ni espacios).');
        }
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      say('Guardando…');
      const res = await fetch(id ? `/api/admin/product-types/${id}/` : '/api/admin/product-types/', {
        method: id ? 'PATCH' : 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      }).catch(() => null);
      const data = (await res?.json().catch(() => null)) as { id?: string; error?: { message?: string } } | null;
      button.disabled = false;
      if (!res?.ok) return say(data?.error?.message ?? 'No se pudo guardar. Inténtalo de nuevo.');
      if (!id && data?.id) {
        window.location.assign(`/admin/product-types/${data.id}/?nuevo=1`);
        return;
      }
      say('Cambios guardados. Así se ve ya en la tienda.');
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === 's') {
        event.preventDefault();
        form.requestSubmit();
      }
    });
  }
</script>
