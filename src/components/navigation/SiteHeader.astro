---
import { t, type Locale } from '@/i18n';
import { localizedPath, type RouteKey } from '@/i18n/routes';
import { getLogoUrl } from '@/lib/content/siteExtras';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const other: Locale = locale === 'en' ? 'es' : 'en';
const logoUrl = await getLogoUrl();
const brandLabel = `${dict.brand.name} ${dict.brand.byline}`;

const links: { key: RouteKey; label: string }[] = [
  { key: 'work', label: dict.nav.work },
  { key: 'gallery', label: dict.nav.gallery },
  { key: 'commissions', label: dict.nav.commissions },
  { key: 'shop', label: dict.nav.shop },
  { key: 'about', label: dict.nav.about },
  { key: 'contact', label: dict.nav.contact },
];

const path = Astro.url.pathname;
const otherPath = path.replace(`/${locale}/`, `/${other}/`);
---

<header class="site-header" data-site-header>
  <div class="site-shell site-header__inner">
    <a class="brand" href={localizedPath(locale, 'home')} aria-label={brandLabel}>
      {
        logoUrl ? (
          <img class="brand__logo" src={logoUrl} alt={brandLabel} width="322" height="264" />
        ) : (
          <span class="brand__fallback display">{dict.brand.name}</span>
        )
      }
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={localizedPath(locale, link.key)}
                aria-current={path.startsWith(localizedPath(locale, link.key)) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="lang" href={otherPath} hreflang={other} lang={other}>
        <span class="visually-hidden">{dict.nav.language}: </span>
        {other.toUpperCase()}
      </a>
      <a class="cart-link" href={localizedPath(locale, 'cart')} data-cart-link>
        <span class="cart-link__label">{dict.nav.cart}</span>
        <svg class="cart-link__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 8h12l-1 12H7L6 8Z" />
          <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
        </svg>
        <span class="cart-count" data-cart-count aria-live="polite">0</span>
      </a>
      <button
        type="button"
        class="menu-toggle"
        data-menu-open
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">{dict.nav.menuOpen}</span>
        <span class="menu-toggle__lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" data-mobile-menu aria-label={dict.nav.menuOpen}>
    <div class="mobile-menu__inner">
      <div class="mobile-menu__bar">
        {
          logoUrl ? (
            <img class="mobile-menu__logo" src={logoUrl} alt="" width="322" height="264" />
          ) : (
            <span />
          )
        }
        <form method="dialog">
          <button class="mobile-menu__close" value="close">
            <span class="visually-hidden">{dict.nav.menuClose}</span>
            <span class="mobile-menu__x" aria-hidden="true"></span>
          </button>
        </form>
      </div>

      <nav aria-label="Mobile" class="mobile-menu__nav">
        <ul>
          {
            [{ key: 'home' as RouteKey, label: dict.nav.home }, ...links].map((link, i) => (
              <li style={`--i: ${i}`}>
                <a
                  href={localizedPath(locale, link.key)}
                  aria-current={
                    (link.key === 'home'
                      ? path === localizedPath(locale, 'home')
                      : path.startsWith(localizedPath(locale, link.key)))
                      ? 'page'
                      : undefined
                  }
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mobile-menu__foot">
        <a class="mobile-menu__cta" href={localizedPath(locale, 'cart')} data-cart-link>
          {dict.nav.cart}
          <span class="cart-count" data-cart-count-menu>0</span>
        </a>
        <div class="mobile-menu__lang" role="group" aria-label={dict.nav.language}>
          <a href={locale === 'es' ? path : otherPath} hreflang="es" lang="es" aria-current={locale === 'es' ? 'true' : undefined}>ES</a>
          <a href={locale === 'en' ? path : otherPath} hreflang="en" lang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <p class="mobile-menu__contact">
          <a href="mailto:info@petsdrawings.com">info@petsdrawings.com</a>
          <a href="https://www.instagram.com/petsdrawings_meili/" rel="noopener noreferrer" target="_blank">Instagram</a>
        </p>
      </div>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    overflow: visible;
    background: var(--paper);
    view-transition-name: site-header;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-5);
    align-items: center;
    min-height: 4.25rem;
    padding-block: 0;
  }

  .site-header::after {
    content: '';
    position: absolute;
    z-index: 1;
    bottom: 0;
    right: 0;
    height: 1px;
    background: var(--line);
    pointer-events: none;
    left: calc((100% - min(100% - 2.5rem, var(--max-editorial))) / 2 + 6rem + var(--space-5));
  }

  @media (min-width: 48rem) {
    .site-header::after {
      left: calc((100% - min(100% - 5rem, var(--max-editorial))) / 2 + 6rem + var(--space-5));
    }
  }

  .brand {
    position: relative;
    align-self: stretch;
    width: 6rem;
    line-height: 0;
  }

  .brand__logo {
    position: absolute;
    z-index: 2;
    top: 0.4rem;
    left: 0;
    height: 4.75rem;
    width: auto;
  }

  .brand__fallback {
    font-size: 1.6rem;
    color: var(--ink);
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.6rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    position: relative;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.98rem;
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-desktop a:hover::after,
  .nav-desktop a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .lang,
  .cart-link,
  .menu-toggle {
    font: inherit;
    font-size: 0.98rem;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: none;
    cursor: pointer;
  }

  .cart-link {
    display: inline-flex;
    align-items: center;
  }

  .cart-link__icon {
    display: none;
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .cart-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    margin-left: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
  }

  .menu-toggle__lines,
  .menu-toggle__lines::after {
    display: block;
    width: 1.6rem;
    height: 1.5px;
    background: currentColor;
  }

  .menu-toggle__lines {
    position: relative;
    transform: translateY(-4px);
  }

  .menu-toggle__lines::after {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 8px;
    width: 1.15rem;
  }

  /* ——— Full-screen mobile menu ——— */
  .mobile-menu {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    border: 0;
    padding: 0;
    background:
      radial-gradient(ellipse 80% 45% at 85% 0%, #fff 0%, transparent 70%),
      var(--paper);
    color: var(--ink);
  }

  .mobile-menu[open] {
    animation: menu-in 420ms var(--ease-out) both;
  }

  .mobile-menu::backdrop {
    background: var(--paper);
  }

  .mobile-menu__inner {
    min-height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 0.6rem 1.25rem max(1.5rem, env(safe-area-inset-bottom));
  }

  .mobile-menu__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-menu__logo {
    height: 3.6rem;
    width: auto;
    mix-blend-mode: multiply;
  }

  .mobile-menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink);
  }

  .mobile-menu__x {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
  }

  .mobile-menu__x::before,
  .mobile-menu__x::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transform: rotate(45deg);
  }

  .mobile-menu__x::after {
    transform: rotate(-45deg);
  }

  .mobile-menu__nav {
    align-self: center;
    padding-block: 2rem;
  }

  .mobile-menu__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .mobile-menu__nav li {
    animation: link-in 600ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--i) * 55ms);
  }

  .mobile-menu__nav a {
    display: inline-block;
    padding-block: 0.2rem;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 11vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-menu__nav a[aria-current='page'] {
    font-style: italic;
    color: var(--accent);
  }

  .mobile-menu__foot {
    display: grid;
    gap: 1.1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    animation: link-in 600ms var(--ease-out) 500ms both;
  }

  .mobile-menu__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--light);
    text-decoration: none;
  }

  .mobile-menu__cta .cart-count {
    border-color: rgb(255 255 255 / 0.4);
  }

  .mobile-menu__lang {
    display: flex;
    gap: 0.4rem;
  }

  .mobile-menu__lang a {
    display: grid;
    place-items: center;
    min-width: 3rem;
    min-height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }

  .mobile-menu__lang a[aria-current='true'] {
    border-color: var(--ink);
    color: var(--ink);
  }

  .mobile-menu__contact {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    font-size: 0.95rem;
  }

  .mobile-menu__contact a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes link-in {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 63.99rem) {
    .lang {
      display: none;
    }

    .cart-link__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .cart-link__icon {
      display: block;
    }

    .cart-count {
      margin-left: 0.15rem;
    }
  }

  @media (min-width: 64rem) {
    .nav-desktop {
      display: block;
    }

    .site-header::after {
      left: calc((100% - min(100% - 5rem, var(--max-editorial))) / 2 + 12.25rem + var(--space-5));
    }

    .brand {
      width: 12.25rem;
    }

    .brand__logo {
      height: 10rem;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .site-header::after {
      left: calc((100% - min(100% - 8rem, var(--max-editorial))) / 2 + 12.25rem + var(--space-5));
    }
  }
</style>

<script>
  const openBtn = document.querySelector('[data-menu-open]');
  const dialog = document.querySelector('[data-mobile-menu]');
  if (openBtn instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement) {
    openBtn.addEventListener('click', () => {
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }

  function readCartCount() {
    try {
      const raw = localStorage.getItem('petsdrawings.cart.v1');
      if (!raw) return 0;
      const parsed = JSON.parse(raw);
      if (!parsed?.items) return 0;
      return parsed.items.reduce(
        (n: number, item: { quantity?: number }) => n + (item.quantity || 0),
        0,
      );
    } catch {
      return 0;
    }
  }

  function syncCartCount() {
    const count = String(readCartCount());
    document.querySelectorAll('[data-cart-count], [data-cart-count-menu]').forEach((el) => {
      el.textContent = count;
    });
  }

  syncCartCount();
  window.addEventListener('storage', syncCartCount);
  window.addEventListener('petsdrawings:cart', syncCartCount);
</script>
