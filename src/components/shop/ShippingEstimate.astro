---
import { t, type Locale } from '@/i18n';
import { countryOptions } from '@/lib/domain/countries';

interface Props {
  locale: Locale;
  /** Keeps the destination fields always visible (checkout page). */
  expanded?: boolean;
}

const { locale, expanded = false } = Astro.props;
const dict = t(locale);
const countries = countryOptions(locale);
const names = Object.fromEntries(countries.map((c) => [c.code, c.name]));
const uid = Math.random().toString(36).slice(2, 8);
const labels = {
  choose: dict.shipping.choose,
  calculating: dict.shipping.calculating,
  free: dict.shipping.free,
  freeOver: dict.shipping.freeOver,
  remaining: dict.shipping.remaining,
  delivery: dict.shipping.delivery,
  unavailable: dict.shipping.unavailable,
  tooHeavy: dict.shipping.tooHeavy,
  postalRequired: dict.shipping.postalRequired,
  error: dict.shipping.error,
};
---

<div
  class:list={['ship', { 'ship--expanded': expanded }]}
  data-shipping
  data-locale={locale}
  data-expanded={String(expanded)}
  data-labels={JSON.stringify(labels)}
  data-names={JSON.stringify(names)}
>
  <div class="ship__row">
    <span class="ship__label">{dict.shipping.label}</span>
    <span class="ship__value price" data-ship-value aria-live="polite">—</span>
  </div>

  {
    !expanded && (
      <button type="button" class="ship__dest" data-ship-toggle aria-expanded="false" aria-controls={`ship-form-${uid}`}>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 14.5s4.5-4.2 4.5-8A4.5 4.5 0 0 0 3.5 6.5c0 3.8 4.5 8 4.5 8Z" />
          <circle cx="8" cy="6.5" r="1.6" />
        </svg>
        <span class="ship__dest-text" data-ship-dest>{dict.shipping.choose}</span>
        <span class="ship__change">{dict.shipping.change}</span>
      </button>
    )
  }

  <div class="ship__form" id={`ship-form-${uid}`} data-ship-form hidden={!expanded}>
    <label class="ship__field" for={`ship-country-${uid}`}>
      <span>{dict.shipping.country}</span>
      <select id={`ship-country-${uid}`} data-ship-country autocomplete="country">
        <option value="" disabled selected>{dict.shipping.choose}</option>
        {countries.map((c) => <option value={c.code}>{c.name}</option>)}
      </select>
    </label>
    <label class="ship__field ship__field--postal" for={`ship-postal-${uid}`} data-ship-postal-wrap hidden>
      <span>{dict.shipping.postalCode}</span>
      <input
        id={`ship-postal-${uid}`}
        data-ship-postal
        inputmode="numeric"
        autocomplete="postal-code"
        maxlength="5"
        pattern="\d{5}"
        placeholder="28001"
      />
    </label>
    <p class="ship__hint" data-ship-hint hidden>{dict.shipping.postalHint}</p>
  </div>

  <p class="ship__note" data-ship-note aria-live="polite" hidden></p>
</div>

<style>
  .ship {
    display: grid;
    gap: 0.45rem;
  }

  .ship__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .ship__label {
    color: var(--muted, #6b645c);
  }

  .ship__value {
    font-variant-numeric: tabular-nums;
    transition: opacity 160ms ease;
  }

  .ship__value[data-pending] {
    opacity: 0.5;
  }

  .ship__value[data-free] {
    color: var(--accent-ink, #3f6b4f);
    font-weight: 600;
  }

  .ship__dest {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px dashed color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 0.6rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.88rem;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .ship__dest:hover,
  .ship__dest[aria-expanded='true'] {
    border-style: solid;
    background: color-mix(in srgb, currentColor 4%, transparent);
  }

  .ship__dest svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    opacity: 0.7;
  }

  .ship__dest-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ship__change {
    flex: none;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    opacity: 0.75;
  }

  .ship__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7.5rem;
    gap: 0.6rem;
    padding-top: 0.25rem;
  }

  .ship__form[hidden] {
    display: none;
  }

  .ship__field {
    display: grid;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted, #6b645c);
  }

  .ship__form:has(.ship__field--postal[hidden]) .ship__field:first-child {
    grid-column: 1 / -1;
  }

  .ship__field[hidden] {
    display: none;
  }

  .ship__field select,
  .ship__field input {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 0.5rem;
    background: var(--paper, #fff);
    color: var(--ink, #1f1b16);
    font: inherit;
    font-size: 0.95rem;
  }

  .ship__field input:invalid:not(:placeholder-shown):not(:focus) {
    border-color: #b4532a;
  }

  .ship__hint {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.78rem;
    color: var(--muted, #6b645c);
  }

  .ship__note {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted, #6b645c);
  }

  .ship__note[data-tone='warn'] {
    color: #8a4a1c;
  }

  .ship__note :global(strong) {
    color: var(--ink, #1f1b16);
    font-weight: 600;
  }

  .ship__note :global(.ship__progress) {
    display: block;
    height: 3px;
    margin-top: 0.4rem;
    border-radius: 3px;
    background: color-mix(in srgb, currentColor 10%, transparent);
    overflow: hidden;
  }

  .ship__note :global(.ship__progress i) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent, #6f8f74);
    transition: width 400ms ease;
  }
</style>

<script>
  import { CART_EVENT, readCart } from '@/stores/cart';
  import {
    DESTINATION_EVENT,
    estimateShipping,
    isCompleteDestination,
    needsPostalCode,
    readDestination,
    writeDestination,
    type Destination,
  } from '@/stores/destination';

  type Labels = Record<string, string>;

  function mount(root: HTMLElement) {
    const locale = root.dataset.locale === 'en' ? 'en' : 'es';
    const labels = JSON.parse(root.dataset.labels ?? '{}') as Labels;
    const names = JSON.parse(root.dataset.names ?? '{}') as Record<string, string>;
    const expanded = root.dataset.expanded === 'true';
    const value = root.querySelector<HTMLElement>('[data-ship-value]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-ship-toggle]');
    const destText = root.querySelector<HTMLElement>('[data-ship-dest]');
    const form = root.querySelector<HTMLElement>('[data-ship-form]')!;
    const country = root.querySelector<HTMLSelectElement>('[data-ship-country]')!;
    const postalWrap = root.querySelector<HTMLElement>('[data-ship-postal-wrap]')!;
    const postal = root.querySelector<HTMLInputElement>('[data-ship-postal]')!;
    const hint = root.querySelector<HTMLElement>('[data-ship-hint]')!;
    const note = root.querySelector<HTMLElement>('[data-ship-note]')!;
    let run = 0;

    const fill = (text: string, amount: string) => text.replace('{amount}', amount);

    function setOpen(open: boolean) {
      if (expanded) return;
      form.hidden = !open;
      toggle?.setAttribute('aria-expanded', String(open));
    }

    function setNote(html: string, tone: 'info' | 'warn' = 'info') {
      note.hidden = !html;
      note.dataset.tone = tone;
      note.innerHTML = html;
    }

    function emit(detail: { ready: boolean; cents?: number; destination?: Destination }) {
      root.dispatchEvent(new CustomEvent('shipping:update', { detail, bubbles: true }));
    }

    function syncFields(dest: Destination | null) {
      if (dest && country.value !== dest.country) country.value = dest.country;
      if (dest && document.activeElement !== postal) postal.value = dest.postalCode;
      const es = needsPostalCode(country.value);
      postalWrap.hidden = !es;
      hint.hidden = !es;
    }

    function destinationLabel(dest: Destination, zone?: string) {
      const parts = [names[dest.country] ?? dest.country];
      if (dest.postalCode) parts.push(dest.postalCode);
      if (zone && zone !== parts[0]) parts.push(zone);
      return parts.join(' · ');
    }

    async function compute() {
      const id = ++run;
      const dest = readDestination();
      syncFields(dest);
      const items = readCart().items;
      if (!isCompleteDestination(dest)) {
        value.textContent = '—';
        delete value.dataset.free;
        delete value.dataset.pending;
        if (destText) destText.textContent = labels.choose;
        setNote('');
        emit({ ready: false });
        return;
      }
      if (destText) destText.textContent = destinationLabel(dest);
      if (items.length === 0) {
        emit({ ready: false });
        return;
      }
      value.dataset.pending = '';
      value.textContent = labels.calculating;
      try {
        const estimate = await estimateShipping(locale, items, dest);
        if (id !== run) return;
        delete value.dataset.pending;
        if (!estimate.available) {
          value.textContent = '—';
          delete value.dataset.free;
          const reason =
            estimate.reason === 'TOO_HEAVY'
              ? labels.tooHeavy
              : estimate.reason === 'POSTAL_CODE_REQUIRED'
                ? labels.postalRequired
                : labels.unavailable;
          setNote(reason, 'warn');
          setOpen(true);
          emit({ ready: false });
          return;
        }
        const free = estimate.shippingCents === 0;
        value.textContent = free ? labels.free : estimate.shippingFormatted;
        if (free) value.dataset.free = '';
        else delete value.dataset.free;
        if (destText) destText.textContent = destinationLabel(dest, estimate.zoneName);

        const lines: string[] = [];
        if (estimate.delivery) lines.push(labels.delivery.replace('{days}', estimate.delivery));
        if (estimate.remainingForFreeFormatted && estimate.freeOverCents) {
          const done = Math.max(0, Math.min(1, 1 - (estimate.remainingForFreeCents ?? 0) / estimate.freeOverCents));
          lines.push(
            `${fill(labels.remaining, `<strong>${estimate.remainingForFreeFormatted}</strong>`)}<span class="ship__progress" aria-hidden="true"><i style="width:${Math.round(done * 100)}%"></i></span>`,
          );
        }
        setNote(lines.join('<br />'));
        emit({ ready: true, cents: estimate.shippingCents, destination: dest });
      } catch {
        if (id !== run) return;
        delete value.dataset.pending;
        value.textContent = '—';
        setNote(labels.error, 'warn');
        emit({ ready: false });
      }
    }

    function save() {
      const dest = { country: country.value, postalCode: postal.value.replace(/\D/g, '') };
      if (!dest.country) return;
      writeDestination(dest);
    }

    toggle?.addEventListener('click', () => {
      const open = form.hidden;
      setOpen(open);
      if (open) country.focus();
    });

    country.addEventListener('change', () => {
      syncFields(null);
      if (needsPostalCode(country.value)) {
        if (/^\d{5}$/.test(postal.value)) save();
        else {
          writeDestination({ country: country.value, postalCode: '' });
          postal.focus();
        }
      } else {
        save();
      }
    });

    postal.addEventListener('input', () => {
      postal.value = postal.value.replace(/\D/g, '').slice(0, 5);
      if (postal.value.length === 5) save();
    });

    postal.addEventListener('blur', () => {
      if (postal.value && postal.value.length < 5) setNote(labels.postalRequired, 'warn');
    });

    root.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (next && root.contains(next)) return;
      if (isCompleteDestination(readDestination())) setOpen(false);
    });

    window.addEventListener(DESTINATION_EVENT, () => void compute());
    window.addEventListener(CART_EVENT, () => void compute());
    window.addEventListener('storage', () => void compute());

    if (!isCompleteDestination(readDestination())) setOpen(true);
    void compute();
  }

  document.querySelectorAll<HTMLElement>('[data-shipping]').forEach(mount);
</script>
