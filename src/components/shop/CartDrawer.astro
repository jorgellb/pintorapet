---
import CartView from '@/components/shop/CartView.astro';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<dialog
  class="cart-drawer"
  data-cart-drawer
  aria-labelledby="cart-drawer-title"
  data-item-one={dict.cart.itemOne}
  data-item-other={dict.cart.itemOther}
>
  <div class="cart-drawer__panel">
    <header class="cart-drawer__head">
      <h2 class="cart-drawer__title display" id="cart-drawer-title">
        {dict.cart.title}
        <span class="cart-drawer__count" data-drawer-count></span>
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-close>
        <span class="visually-hidden">{dict.cart.close}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" /></svg>
      </button>
    </header>
    <CartView locale={locale} variant="drawer" />
  </div>
</dialog>

<button type="button" class="cart-fab" data-cart-fab aria-label={dict.cart.open} hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M6 8h12l-1 12H7L6 8Z" />
    <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
  </svg>
  <span class="cart-fab__count" data-fab-count>0</span>
</button>

<style>
  .cart-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(27rem, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow: -30px 0 60px -30px rgb(22 23 26 / 0.35);
    overflow: hidden;
  }

  .cart-drawer[open] {
    animation: drawer-in 520ms var(--ease-out) both;
  }

  .cart-drawer.is-closing {
    animation: drawer-out 300ms var(--ease-soft) both;
  }

  .cart-drawer::backdrop {
    background: rgb(22 23 26 / 0.24);
    backdrop-filter: blur(1.5px);
    animation: fade-in 400ms var(--ease-out) both;
  }

  .cart-drawer.is-closing::backdrop {
    animation: fade-out 300ms var(--ease-soft) both;
  }

  .cart-drawer__panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100%;
  }

  .cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 1.5rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .cart-drawer__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    font-size: 1.85rem;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .cart-drawer__count {
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0;
    color: var(--muted);
  }

  .cart-drawer__close {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--dur-ui) var(--ease-soft),
      transform var(--dur-ui) var(--ease-out);
  }

  .cart-drawer__close:hover {
    border-color: var(--line-strong);
    transform: rotate(90deg);
  }

  .cart-drawer__close svg {
    width: 1.15rem;
    height: 1.15rem;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  /* ——— Floating button ——— */
  .cart-fab {
    position: fixed;
    z-index: 45;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--light);
    cursor: pointer;
    box-shadow:
      0 2px 4px rgb(22 23 26 / 0.12),
      0 18px 32px -14px rgb(22 23 26 / 0.45);
    transition:
      transform 420ms var(--ease-out),
      opacity 300ms var(--ease-soft),
      background var(--dur-ui) var(--ease-soft),
      visibility 0s;
  }

  .cart-fab[hidden] {
    display: grid;
    visibility: hidden;
    opacity: 0;
    transition:
      transform 420ms var(--ease-out),
      opacity 300ms var(--ease-soft),
      visibility 0s 300ms;
    transform: translateY(1.5rem) scale(0.85);
    pointer-events: none;
  }

  :global(body:has(.cookie-note.is-open)) .cart-fab {
    bottom: max(8.5rem, calc(env(safe-area-inset-bottom) + 7.25rem));
  }

  .cart-fab:hover {
    background: var(--accent-deep);
    transform: translateY(-2px);
  }

  .cart-fab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .cart-fab svg {
    width: 1.45rem;
    height: 1.45rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linejoin: round;
  }

  .cart-fab__count {
    position: absolute;
    top: -0.15rem;
    right: -0.15rem;
    display: grid;
    place-items: center;
    min-width: 1.45rem;
    height: 1.45rem;
    padding: 0 0.3rem;
    border: 2px solid var(--paper);
    border-radius: 999px;
    background: var(--accent);
    color: var(--light);
    font-size: 0.72rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .cart-fab.is-bumped {
    animation: fab-bump 520ms var(--ease-out);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }

  @keyframes drawer-out {
    to {
      transform: translateX(100%);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes fab-bump {
    30% {
      transform: scale(1.14);
    }
    60% {
      transform: scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer[open],
    .cart-drawer.is-closing,
    .cart-drawer::backdrop,
    .cart-fab,
    .cart-fab.is-bumped {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { CART_EVENT, CART_OPEN_EVENT, cartCount } from '@/stores/cart';

  const drawer = document.querySelector<HTMLDialogElement>('[data-cart-drawer]');
  const fab = document.querySelector<HTMLButtonElement>('[data-cart-fab]');

  if (drawer && fab) {
    const one = drawer.dataset.itemOne ?? '';
    const other = drawer.dataset.itemOther ?? '';
    const countLabel = drawer.querySelector<HTMLElement>('[data-drawer-count]');
    const fabCount = fab.querySelector<HTMLElement>('[data-fab-count]');
    const headerLink = document.querySelector<HTMLElement>('[data-cart-link]');
    const onCartPage = Boolean(document.querySelector('[data-cart-view][data-variant="page"]'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let lastCount = cartCount();
    let headerVisible = true;
    let opener: HTMLElement | null = null;

    const open = () => {
      if (drawer.open) return;
      const menu = document.querySelector<HTMLDialogElement>('[data-mobile-menu][open]');
      if (menu) {
        menu.addEventListener('close', () => window.setTimeout(open), { once: true });
        menu.close();
        return;
      }
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      drawer.classList.remove('is-closing');
      drawer.showModal();
      document.documentElement.style.overflow = 'hidden';
      syncFab();
    };

    const close = () => {
      if (!drawer.open || drawer.classList.contains('is-closing')) return;
      if (reduced.matches) {
        drawer.close();
        return;
      }
      drawer.classList.add('is-closing');
      drawer.addEventListener(
        'animationend',
        () => {
          drawer.classList.remove('is-closing');
          drawer.close();
        },
        { once: true },
      );
    };

    drawer.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      syncFab();
      opener?.focus({ preventScroll: true });
    });

    drawer.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) close();
      if ((event.target as HTMLElement).closest('[data-cart-close]')) close();
    });

    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-cart-link]');
      if (!link || onCartPage || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      open();
    });

    fab.addEventListener('click', open);
    window.addEventListener(CART_OPEN_EVENT, open);

    function syncFab() {
      const count = cartCount();
      fab!.hidden = count === 0 || headerVisible || drawer!.open || onCartPage;
      if (fabCount) fabCount.textContent = String(count);
      if (countLabel) countLabel.textContent = count ? `${count} ${count === 1 ? one : other}` : '';
      if (count > lastCount && !fab!.hidden && !reduced.matches) {
        fab!.classList.remove('is-bumped');
        void fab!.offsetWidth;
        fab!.classList.add('is-bumped');
      }
      lastCount = count;
    }

    if (headerLink && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        headerVisible = entry.isIntersecting;
        syncFab();
      }).observe(headerLink);
    } else {
      headerVisible = false;
    }

    window.addEventListener(CART_EVENT, syncFab);
    window.addEventListener('storage', syncFab);
    syncFab();
  }
</script>
