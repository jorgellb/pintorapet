---
import { t, type Locale } from '@/i18n';
import { localizedPath } from '@/i18n/routes';
import { formatEur } from '@/lib/domain/money';
import type { ProductPublic } from '@/lib/domain/types';

/** One piece on the shop's stall: framed photo, hanging price tag, add to cart. */
interface Props {
  product: ProductPublic;
  /** The type ("Taza") in a portrait's row; the portrait ("Pug") when one type is shown. */
  title: string;
  /** The type, on the price tag. */
  kind: string;
  /** How far the tag leans, in degrees. */
  tilt: number;
  eager: boolean;
  locale: Locale;
}

const { product, title, kind, tilt, eager, locale } = Astro.props;
const es = locale === 'es';
const dict = t(locale);
const href = localizedPath(locale, 'shop', product.slug);
const alt = product.imageUrls[1];
const addable = product.saleEnabled && product.availability !== 'sold_out' && product.availability !== 'unavailable';
const status =
  product.availability === 'sold_out'
    ? dict.shop.soldOut
    : product.availability === 'unavailable'
      ? dict.shop.unavailable
      : dict.shop.unverified;
---

<li class="item" style={`--r:${tilt}deg`}>
  <a class="item__frame" href={href} aria-label={product.title}>
    {
      product.coverImageUrl ? (
        <img
          class="item__img"
          src={product.coverImageUrl}
          alt={product.title}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <span class="item__ph" />
      )
    }
    {alt && <img class="item__img item__img--alt" src={alt} alt="" loading="lazy" decoding="async" />}
  </a>

  <span class="tag" aria-hidden="true">
    <span class="tag__string"></span>
    <span class="tag__card">
      <span class="tag__kind">{kind}</span>
      <span class="tag__price">{formatEur(product.priceCents, locale)}</span>
    </span>
  </span>

  <div class="item__body">
    <h3 class="item__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="item__price price">{formatEur(product.priceCents, locale)}</p>
    {
      addable ? (
        <button
          type="button"
          class="btn item__add"
          data-add-to-cart
          data-product-id={product.id}
          data-done={es ? 'Añadido' : 'Added'}
        >
          {dict.shop.addToCart}
        </button>
      ) : (
        <p class="item__status">
          {status} · <a href={localizedPath(locale, 'contact')}>{es ? 'pregunta a Meili' : 'ask Meili'}</a>
        </p>
      )
    }
  </div>
</li>

<style>
  .item {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    scroll-snap-align: start;
  }

  .item__frame {
    position: relative;
    display: block;
    padding: 0.55rem;
    background: var(--sheet);
    box-shadow: var(--shadow-art);
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out);
  }

  .item__img,
  .item__ph {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    box-shadow: none;
    border-radius: 0;
    background: var(--paper-deep);
  }

  .item__img--alt {
    position: absolute;
    inset: 0.55rem;
    width: calc(100% - 1.1rem);
    opacity: 0;
    transition: opacity 600ms var(--ease-soft);
  }

  .item:hover .item__frame {
    transform: translateY(-6px);
    box-shadow:
      0 1px 2px rgb(22 23 26 / 0.06),
      0 20px 34px -12px rgb(22 23 26 / 0.16),
      0 60px 90px -36px rgb(22 23 26 / 0.28);
  }

  .item:hover .item__img--alt {
    opacity: 1;
  }

  /* ——— Kraft price tags on a string ——— */
  .tag {
    position: absolute;
    z-index: 3;
    top: -1.1rem;
    right: 1.1rem;
    display: grid;
    justify-items: center;
    transform-origin: 50% 0;
    rotate: var(--r);
    pointer-events: none;
    filter: drop-shadow(0 6px 6px rgb(22 23 26 / 0.18));
  }

  .tag::before {
    /* the pin on the wall */
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    margin-bottom: -0.2rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #8e9bbb, var(--accent-deep));
    box-shadow: 0 1px 2px rgb(22 23 26 / 0.35);
  }

  .tag__string {
    width: 1px;
    height: 1.6rem;
    background: #8d7a5c;
  }

  .tag__card {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    min-width: 4.6rem;
    margin-top: -0.55rem;
    padding: 1.15rem 0.55rem 0.6rem;
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.25), transparent 60%),
      #dcc39b;
    clip-path: polygon(50% 0, 100% 1.1rem, 100% 100%, 0 100%, 0 1.1rem);
    -webkit-mask: radial-gradient(circle 0.2rem at 50% 0.85rem, transparent 96%, #000 100%);
    mask: radial-gradient(circle 0.2rem at 50% 0.85rem, transparent 96%, #000 100%);
    color: #3b2f1c;
    text-align: center;
  }

  .tag__kind {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .tag__price {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .item:hover .tag {
    animation: swing 1.6s cubic-bezier(0.3, 0.6, 0.4, 1);
  }

  @keyframes swing {
    0% {
      rotate: var(--r);
    }
    18% {
      rotate: calc(var(--r) * -1 + 6deg);
    }
    40% {
      rotate: calc(var(--r) - 5deg);
    }
    62% {
      rotate: calc(var(--r) * -0.5 + 3deg);
    }
    82% {
      rotate: calc(var(--r) - 1deg);
    }
    100% {
      rotate: var(--r);
    }
  }

  .item__body {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .item__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .item__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .item__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .item__price {
    margin: 0;
    color: var(--ink-soft);
  }

  .item__add {
    margin-top: 0.4rem;
    min-height: 2.6rem;
    padding: 0.5rem 1.2rem;
  }

  .item__status {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .item__status a {
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .item:hover .tag {
      animation: none;
    }
  }
</style>
