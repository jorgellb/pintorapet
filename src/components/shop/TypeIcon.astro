---
import type { TypeIcon } from '@/lib/catalog/productTypes';

/** The line drawing of a product type (Admin › Tienda › Tipos de producto › Icono). */
interface Props {
  icon: TypeIcon;
  class?: string;
}

const { icon, class: className } = Astro.props;
---

<svg class:list={['type-icon', className]} viewBox="0 0 24 24" aria-hidden="true">
  {
    icon === 'card' && (
      <>
        <path d="M5 4h11l3 3v13H5z" />
        <path d="M16 4v3h3" />
      </>
    )
  }
  {
    icon === 'coaster' && (
      <>
        <rect x="4" y="4" width="16" height="14" rx="3" />
        <path d="M6 20.5h12" />
      </>
    )
  }
  {
    icon === 'mug' && (
      <>
        <path d="M5 6h11v10a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z" />
        <path d="M16 9h1.5a2.5 2.5 0 0 1 0 5H16" />
      </>
    )
  }
  {
    icon === 'ornament' && (
      <>
        <circle cx="12" cy="14.5" r="6.5" />
        <path d="M12 8V3.5" />
        <path d="M12 8c-1.6-1.6-4-1.4-4 .1 0 1.4 2.4 1.1 4-.1zm0 0c1.6-1.6 4-1.4 4 .1 0 1.4-2.4 1.1-4-.1z" />
      </>
    )
  }
  {
    icon === 'keyring' && (
      <>
        <circle cx="8" cy="7" r="4" />
        <path d="M10.8 9.8l2.4 2.4" />
        <rect x="11.5" y="11.5" width="8" height="10" rx="2" transform="rotate(-45 15.5 16.5)" />
      </>
    )
  }
  {
    icon === 'print' && (
      <>
        <rect x="4" y="3" width="16" height="18" rx="1" />
        <rect x="7" y="6" width="10" height="9" />
        <path d="M7 18h6" />
      </>
    )
  }
  {
    icon === 'bag' && (
      <>
        <path d="M5 8h14l-1 13H6z" />
        <path d="M9 10V6a3 3 0 0 1 6 0v4" />
      </>
    )
  }
  {
    icon === 'tag' && (
      <>
        <path d="M3.5 12.5V4h8.5l8.5 8.5-8.5 8.5z" />
        <circle cx="8" cy="8.5" r="1.4" />
      </>
    )
  }
</svg>

<style>
  .type-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
</style>
