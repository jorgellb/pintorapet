---
interface Props {
  photoSrc: string;
  drawingSrc: string;
  photoAlt: string;
  drawingAlt: string;
  photoLabel: string;
  drawingLabel: string;
  hint: string;
  compact?: boolean;
}

const {
  photoSrc,
  drawingSrc,
  photoAlt,
  drawingAlt,
  photoLabel,
  drawingLabel,
  hint,
  compact = false,
} = Astro.props;
---

<div class:list={['compare', { 'compare--compact': compact }]} data-compare>
  <div class="compare__stage">
    <img class="compare__base" src={photoSrc} alt={photoAlt} loading="lazy" decoding="async" />
    <img
      class="compare__overlay"
      src={drawingSrc}
      alt={drawingAlt}
      loading="lazy"
      decoding="async"
      data-compare-overlay
      style="clip-path: inset(0 50% 0 0)"
    />
    <div class="compare__divider" data-compare-divider style="left: 50%" aria-hidden="true"></div>
  </div>
  <label class="compare__control">
    <span class="visually-hidden">{hint}</span>
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      data-compare-range
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-label={hint}
    />
  </label>
  <p class="compare__labels muted">
    <span>{drawingLabel}</span>
    <span>{photoLabel}</span>
  </p>
</div>

<style>
  .compare {
    display: grid;
    gap: 0.75rem;
  }

  .compare__stage {
    position: relative;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow-art);
    aspect-ratio: 4 / 5;
  }

  .compare__base,
  .compare__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }

  .compare__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .compare__control input {
    width: 100%;
    accent-color: var(--accent);
  }

  .compare__labels {
    display: flex;
    justify-content: space-between;
    margin: 0;
    font-size: 0.9rem;
  }

  .compare--compact {
    width: min(100%, 26rem);
  }

  .compare--compact .compare__stage {
    aspect-ratio: 4 / 3;
    width: 100%;
    max-height: 20rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  document.querySelectorAll('[data-compare]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const range = root.querySelector('[data-compare-range]');
    const overlay = root.querySelector('[data-compare-overlay]');
    const divider = root.querySelector('[data-compare-divider]');
    if (
      !(range instanceof HTMLInputElement) ||
      !(overlay instanceof HTMLElement) ||
      !(divider instanceof HTMLElement)
    ) {
      return;
    }

    const apply = () => {
      const value = Number(range.value);
      const right = 100 - value;
      overlay.style.clipPath = `inset(0 ${right}% 0 0)`;
      divider.style.left = `${value}%`;
      range.setAttribute('aria-valuenow', String(value));
    };

    range.addEventListener('input', apply);
    apply();
  });
</script>
