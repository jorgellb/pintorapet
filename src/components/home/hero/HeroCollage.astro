---
import type { Locale } from '@/i18n';
import type { ResolvedHero } from '@/lib/content/homeHero';

/** Design 1 · Estudio: sheets pinned to the studio wall around the drawing, the photo it came from, a pencil arrow between them. */
interface Props {
  hero: ResolvedHero;
  locale: Locale;
}

const { hero } = Astro.props;
const pieces = hero.extras.slice(0, 4);
---

<section class="hero">
  <div class="site-shell hero__grid">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title display">
      <span class="hero__line hero__line--top">{hero.titleTop}</span>
      {hero.titleBottom && <span class="hero__line hero__line--bottom">{hero.titleBottom}</span>}
    </h1>

    <div class="hero__art collage" data-collage>
      {
        pieces.map((piece, i) => {
          const image = (
            <span class="piece__sheet">
              <img
                src={piece.src}
                alt={piece.alt}
                loading="eager"
                decoding="async"
                style={piece.workId ? `view-transition-name: work-${piece.workId}` : undefined}
              />
            </span>
          );
          return piece.href ? (
            <a class={`piece piece--${i + 1}`} href={piece.href} style={`--i:${i + 1}`}>
              {image}
            </a>
          ) : (
            <div class={`piece piece--${i + 1}`} style={`--i:${i + 1}`}>
              {image}
            </div>
          );
        })
      }

      {
        hero.photo && (
          <figure class="piece piece--photo" style="--i:5">
            <span class="piece__sheet polaroid">
              <img src={hero.photo.src} alt={hero.photo.alt} loading="eager" decoding="async" />
              <figcaption>{hero.photo.caption}</figcaption>
            </span>
          </figure>
        )
      }

      {
        hero.photo && hero.main && (
          <svg class="collage__arrow" viewBox="0 0 120 80" aria-hidden="true">
            <path d="M8 74 C 18 30, 60 6, 110 20" pathLength="1" />
            <path d="M95 8 L110 20 L93 28" pathLength="1" />
          </svg>
        )
      }

      <div class="piece piece--hero" style="--i:0">
        <div class="hero__sheet" data-tilt>
          {
            hero.main && (
              <img
                src={hero.main.src}
                alt={hero.main.alt}
                width="1551"
                height="1080"
                fetchpriority="high"
                decoding="async"
                style={hero.main.workId ? `view-transition-name: work-${hero.main.workId}` : undefined}
              />
            )
          }
          <span class="hero__glare" aria-hidden="true"></span>
        </div>
      </div>
    </div>

    <div class="hero__aside">
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__cta">
        <a class="btn" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="btn btn--ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
      </div>
      {
        hero.plaque && (
          <p class="plaque">
            <span class="plaque__label">{hero.plaque.label}</span>
            <a href={hero.plaque.href}>{hero.plaque.title}</a>
            <span>{hero.plaque.note}</span>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  /* ——— Hero: the drawing appears on the wall, line by line ——— */
  .hero {
    position: relative;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(4rem, 8vw, 7rem);
    overflow: clip;
  }

  .hero::before {
    /* gallery spotlight falling on the wall */
    content: '';
    position: absolute;
    inset: -20% 0 auto;
    height: 120%;
    background: radial-gradient(ellipse 45% 55% at 62% 40%, #fff 0%, transparent 70%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__eyebrow {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    animation: rise 1s var(--ease-out) 0.1s both;
  }

  .hero__eyebrow::before {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: currentColor;
  }

  .hero__title {
    margin: 0;
    display: contents;
  }

  .hero__line {
    display: block;
    position: relative;
    z-index: 2;
    font-size: clamp(3rem, 6.5vw, 8.25rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--ink);
    white-space: nowrap;
    text-shadow:
      0 0 24px var(--paper),
      0 0 48px var(--paper);
    animation: rise 1.3s var(--ease-out) 0.25s both;
  }

  .hero__line--bottom {
    font-style: italic;
    font-weight: 400;
    color: var(--accent-deep);
    animation-delay: 1.5s;
  }

  /* ——— Collage: sheets pinned to the studio wall at different depths ——— */
  .collage {
    --px: 0;
    --py: 0;
    --sy: 0;
    position: relative;
    aspect-ratio: 16 / 11;
  }

  .piece {
    --r: 0deg;
    --d: 20;
    --ar: 4 / 5;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    margin: 0;
    z-index: var(--z, 2);
    rotate: var(--r);
    translate: calc(var(--px) * var(--d) * 1px)
      calc(var(--py) * var(--d) * 1px - var(--sy) * var(--d) * 0.012px);
    transition:
      translate 800ms var(--ease-out),
      rotate 500ms var(--ease-out),
      scale 500ms var(--ease-out);
    animation: drop 1.1s cubic-bezier(0.2, 0.9, 0.25, 1.12) calc(0.2s + var(--i) * 0.16s) both;
  }

  .piece__sheet {
    position: relative;
    display: block;
    background: var(--sheet);
    padding: clamp(0.3rem, 0.7vw, 0.65rem);
    box-shadow: var(--shadow-art);
  }

  /* washi tape holding each sheet */
  .piece__sheet::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: -0.7rem;
    left: 50%;
    width: 38%;
    height: 1.35rem;
    translate: -50% 0;
    rotate: -3deg;
    background: rgb(214 220 232 / 0.72);
    box-shadow: 0 1px 2px rgb(22 23 26 / 0.08);
    -webkit-mask-image: linear-gradient(90deg, transparent 0 2%, #000 2% 98%, transparent 98%);
    mask-image: linear-gradient(90deg, transparent 0 2%, #000 2% 98%, transparent 98%);
  }

  .piece img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ar);
    object-fit: cover;
    object-position: 50% 35%;
    box-shadow: none;
    border-radius: 0;
  }

  a.piece:hover,
  a.piece:focus-visible {
    z-index: 8;
    scale: 1.05;
    rotate: calc(var(--r) * 0.3);
  }

  a.piece:focus-visible {
    outline: none;
  }

  a.piece:focus-visible .piece__sheet {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .piece--1 {
    --x: -3%;
    --y: 4%;
    --w: 21%;
    --r: -5deg;
    --d: 30;
    --ar: 3 / 4;
  }

  .piece--2 {
    --x: 75%;
    --y: -4%;
    --w: 24%;
    --r: 4deg;
    --d: 22;
  }

  .piece--3 {
    --x: 79%;
    --y: 50%;
    --w: 21%;
    --r: -3deg;
    --d: 34;
    --z: 3;
  }

  .piece--4 {
    --x: 53%;
    --y: 69%;
    --w: 18%;
    --r: 6deg;
    --d: 42;
    --ar: 1;
    --z: 6;
  }

  .piece--photo {
    --x: 2%;
    --y: 50%;
    --w: 20%;
    --r: -8deg;
    --d: 26;
    --ar: 1;
    --z: 6;
  }

  .polaroid {
    padding-bottom: clamp(2rem, 3.2vw, 2.8rem);
  }

  .polaroid figcaption {
    position: absolute;
    inset: auto 0 clamp(0.45rem, 0.8vw, 0.8rem);
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    color: var(--ink-soft);
  }

  .piece--hero {
    --x: 19%;
    --y: 13%;
    --w: 58%;
    --r: -1deg;
    --d: 8;
    --z: 4;
  }

  .collage__arrow {
    position: absolute;
    z-index: 7;
    left: 22%;
    top: 68%;
    width: 9%;
    overflow: visible;
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .collage__arrow path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ink 1.1s var(--ease-out) 3.3s forwards;
  }

  .collage__arrow path + path {
    animation-duration: 0.4s;
    animation-delay: 4.3s;
  }

  @keyframes ink {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-70px) rotate(-7deg) scale(1.1);
    }
    55% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__sheet {
    position: relative;
    background: var(--sheet);
    box-shadow: var(--shadow-art);
    padding: clamp(0.5rem, 1.2vw, 1rem);
  }

  .hero__sheet img {
    width: 100%;
    aspect-ratio: auto;
    object-fit: contain;
    box-shadow: none;
    border-radius: 0;
    /* graphite appears as if drawn, left to right */
    -webkit-mask-image: linear-gradient(100deg, #000 42%, transparent 58%);
    mask-image: linear-gradient(100deg, #000 42%, transparent 58%);
    -webkit-mask-size: 280% 100%;
    mask-size: 280% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: draw 2.8s cubic-bezier(0.45, 0.05, 0.25, 1) 0.9s both;
  }

  .hero__aside {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 1.6rem;
    max-width: 29rem;
    animation: rise 1.2s var(--ease-out) 1.9s both;
  }

  .hero__lead {
    margin: 0;
    font-size: clamp(1.05rem, 1.15vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .plaque {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .plaque__label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .plaque a {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-ui) var(--ease-soft);
  }

  .plaque a:hover {
    text-decoration-color: currentColor;
  }

  .plaque a + span::before {
    content: '— ';
  }

  @keyframes draw {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
      filter: blur(3px) contrast(0.6);
    }
    70% {
      filter: blur(0) contrast(0.9);
    }
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
      filter: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__sheet img {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .piece {
      animation: none;
      translate: none;
    }

    .collage__arrow path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 63.99rem) {
    .hero {
      padding-top: 1.25rem;
    }

    .hero__grid {
      gap: 0;
    }

    .hero__eyebrow {
      order: 0;
      margin-bottom: 1rem;
      font-size: 0.7rem;
    }

    .hero__line {
      font-size: clamp(2.8rem, 13.5vw, 6rem);
    }

    .hero__line--top {
      order: 1;
    }

    .hero__art {
      order: 2;
      position: relative;
      z-index: 1;
      margin-inline: -0.25rem;
    }

    .collage {
      aspect-ratio: 1 / 1.12;
      margin-block: 0.9rem 1.6rem;
    }

    .hero__sheet {
      padding: 0.45rem;
    }

    .piece__sheet::before {
      top: -0.55rem;
      height: 1rem;
    }

    .piece--hero {
      --x: 5%;
      --y: 21%;
      --w: 90%;
      --r: -1.5deg;
    }

    .piece--1 {
      --x: -4%;
      --y: 0%;
      --w: 31%;
    }

    .piece--2 {
      --x: 69%;
      --y: -1%;
      --w: 33%;
    }

    .piece--3 {
      --x: 69%;
      --y: 62%;
      --w: 33%;
      --z: 5;
    }

    .piece--4 {
      --x: 38%;
      --y: 75%;
      --w: 27%;
    }

    .piece--photo {
      --x: -3%;
      --y: 54%;
      --w: 36%;
    }

    .collage__arrow {
      display: none;
    }

    .hero__line--bottom {
      order: 1;
      text-align: right;
    }

    .hero__aside {
      order: 3;
      gap: 1.4rem;
      margin-top: 0.75rem;
      max-width: none;
    }

    .hero__cta {
      display: grid;
      grid-template-columns: 1fr auto;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      display: grid;
      align-items: center;
      padding-top: 0;
      min-height: calc(100svh - 12.5rem);
    }

    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1fr auto auto auto auto 1fr;
      column-gap: 2rem;
      row-gap: 0;
      align-items: start;
    }

    .hero__eyebrow {
      grid-column: 1 / 7;
      grid-row: 2;
      margin-bottom: clamp(1.25rem, 2vw, 2rem);
    }

    .hero__line--top {
      grid-column: 1 / 8;
      grid-row: 3;
    }

    /* the italic clause steps in, like a second line of verse */
    .hero__line--bottom {
      grid-column: 1 / 10;
      grid-row: 4;
      padding-left: 0.6em;
    }

    .hero__aside {
      grid-column: 1 / 6;
      grid-row: 5;
      margin-top: clamp(1.75rem, 3vw, 2.75rem);
    }

    .hero__art {
      grid-column: 6 / 13;
      grid-row: 1 / -1;
      align-self: center;
      justify-self: end;
      width: min(100%, calc(66svh * 16 / 11));
      z-index: 1;
    }
  }

  /* ——— Hero tilt: the sheet answers the pointer, light slides across ——— */
  [data-tilt] {
    --rx: 0deg;
    --ry: 0deg;
    --gx: 30%;
    --gy: 20%;
    --glare: 0;
    transform: perspective(1600px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 900ms var(--ease-out);
    will-change: transform;
  }

  [data-tilt].is-tilting {
    transition: transform 120ms linear;
  }

  .hero__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--gx) var(--gy),
      rgb(255 255 255 / 0.55),
      rgb(255 255 255 / 0) 45%
    );
    mix-blend-mode: soft-light;
    opacity: var(--glare);
    transition: opacity 600ms var(--ease-out);
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 64rem) and (hover: hover) and (pointer: fine)');

  const art = document.querySelector<HTMLElement>('[data-tilt]');
  if (art) {
    art.addEventListener('pointermove', (e) => {
      if (calm.matches || !desktop.matches) return;
      const r = art.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      art.classList.add('is-tilting');
      art.style.setProperty('--ry', `${(x - 0.5) * 7}deg`);
      art.style.setProperty('--rx', `${(0.5 - y) * 5}deg`);
      art.style.setProperty('--gx', `${x * 100}%`);
      art.style.setProperty('--gy', `${y * 100}%`);
      art.style.setProperty('--glare', '1');
    });
    art.addEventListener('pointerleave', () => {
      art.classList.remove('is-tilting');
      art.style.setProperty('--rx', '0deg');
      art.style.setProperty('--ry', '0deg');
      art.style.setProperty('--glare', '0');
    });
  }

  const collage = document.querySelector<HTMLElement>('[data-collage]');
  const heroSection = collage?.closest<HTMLElement>('.hero');
  if (collage && heroSection) {
    let sframe = 0;
    heroSection.addEventListener('pointermove', (e) => {
      if (calm.matches || !desktop.matches) return;
      const r = heroSection.getBoundingClientRect();
      collage.style.setProperty('--px', (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(3));
      collage.style.setProperty('--py', (((e.clientY - r.top) / r.height - 0.5) * 2).toFixed(3));
    });
    heroSection.addEventListener('pointerleave', () => {
      collage.style.setProperty('--px', '0');
      collage.style.setProperty('--py', '0');
    });
    window.addEventListener(
      'scroll',
      () => {
        if (sframe || calm.matches) return;
        sframe = requestAnimationFrame(() => {
          sframe = 0;
          const y = Math.min(window.scrollY, heroSection.offsetHeight);
          collage.style.setProperty('--sy', String(Math.round(y)));
        });
      },
      { passive: true },
    );
  }
</script>
