---
import ProductPage from '@/views/ProductPage.astro';
import { localizedPath } from '@/i18n/routes';
import { loadProductPage } from '@/lib/catalog/loadProducts';

// Looked up here, before anything is sent: an unknown product goes back to the
// shop (a redirect from inside the view would come too late and leave a blank page).
const page = await loadProductPage('en', Astro.params.slug ?? '');
if (!page) return Astro.redirect(localizedPath('en', 'shop'));
---

<ProductPage locale="en" page={page} />
