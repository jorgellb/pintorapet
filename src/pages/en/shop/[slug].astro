---
import ProductPage from '@/views/ProductPage.astro';
import NotFoundPage from '@/views/NotFoundPage.astro';
import { catalogReadFailed, loadProductPage } from '@/lib/catalog/loadProducts';
import { tryLaterResponse } from '@/lib/seo/status';

// Looked up here, before anything is sent (from inside the view it would be
// too late): an unknown product answers 404 with the error page, or 503
// while the database cannot be read.
const page = await loadProductPage('en', Astro.params.slug ?? '');
if (!page) {
  if (await catalogReadFailed('en')) return tryLaterResponse('en');
  Astro.response.status = 404;
}
---

{page ? <ProductPage locale="en" page={page} /> : <NotFoundPage locale="en" />}
