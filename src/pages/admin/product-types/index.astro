---
import AdminLayout from '@/layouts/AdminLayout.astro';
import TypeIcon from '@/components/shop/TypeIcon.astro';
import { requireAdmin } from '@/lib/server/adminAuth';
import { hasSupabase } from '@/lib/server/env';
import { listProductTypes, type AdminProductType } from '@/lib/server/admin/productTypes';

export const prerender = false;

if (!hasSupabase()) return Astro.redirect('/admin/login/');
const admin = await requireAdmin(Astro.cookies, Astro.request);
if (!admin) return Astro.redirect('/admin/login/');

let types: AdminProductType[] = [];
let failed = false;
try {
  types = await listProductTypes(admin.client);
} catch {
  failed = true;
}
const notice = Astro.url.searchParams.has('borrado') ? 'Tipo de producto borrado.' : null;
---

<AdminLayout title="Tipos de producto" email={admin.user.email}>
  <header class="page-head">
    <div>
      <h1>Tipos de producto</h1>
      <p class="lead">
        Tarjetas, posavasos, tazas… Cada tipo es un filtro de la tienda y da a sus productos nuevos el peso y el IVA.
        Ordénalos con las flechas: la tienda enseña los filtros, y las piezas de cada retrato, en este orden.
      </p>
    </div>
    <a class="btn" href="/admin/product-types/new/">Nuevo tipo</a>
  </header>

  {notice && <p class="status">{notice}</p>}
  <p class="status" data-order-status role="status" hidden></p>

  {
    failed ? (
      <p class="err">No se pudieron cargar los tipos de producto.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Orden</th>
              <th>Tipo</th>
              <th>En la etiqueta</th>
              <th class="num">Productos</th>
              <th class="num">Peso</th>
              <th class="num">IVA</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody data-type-rows>
            {types.map((type) => (
              <tr data-type-id={type.id}>
                <td class="order">
                  <button type="button" class="btn--quiet" data-move="up" aria-label={`Subir ${type.nameEs}`}>↑</button>
                  <button type="button" class="btn--quiet" data-move="down" aria-label={`Bajar ${type.nameEs}`}>↓</button>
                </td>
                <td>
                  <a class="title-cell" href={`/admin/product-types/${type.id}/`}>
                    <span class="icon">
                      <TypeIcon icon={type.icon} />
                    </span>
                    <span>
                      {type.nameEs}
                      <span class="muted line">{type.nameEn}</span>
                    </span>
                  </a>
                </td>
                <td>
                  {type.singularEs}
                  <span class="muted line">{type.singularEn}</span>
                </td>
                <td class="num">
                  <a href={`/admin/products/?categoria=${type.code}`}>{type.productCount}</a>
                </td>
                <td class="num">{type.defaultWeightGrams} g</td>
                <td class="num">{type.vatRate} %</td>
                <td>{type.published ? <span class="chip chip--ok">Visible</span> : <span class="chip">Oculto</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

<style>
  .order {
    white-space: nowrap;
  }

  .order button {
    min-height: 2rem;
    padding: 0.2rem 0.65rem;
  }

  tbody tr:first-child [data-move='up'],
  tbody tr:last-child [data-move='down'] {
    visibility: hidden;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--paper-deep);
  }

  .line {
    display: block;
    font-size: 0.82rem;
  }
</style>

<script>
  const rows = document.querySelector<HTMLElement>('[data-type-rows]');
  const status = document.querySelector<HTMLElement>('[data-order-status]');
  const say = (text: string) => {
    if (!status) return;
    status.hidden = false;
    status.textContent = text;
  };
  rows?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-move]');
    const row = button?.closest('tr');
    if (!button || !row) return;
    const sibling = button.dataset.move === 'up' ? row.previousElementSibling : row.nextElementSibling;
    if (!sibling) return;
    if (button.dataset.move === 'up') sibling.before(row);
    else sibling.after(row);
    button.focus();
    const ids = [...rows.querySelectorAll<HTMLElement>('[data-type-id]')].map((tr) => tr.dataset.typeId!);
    say('Guardando el orden…');
    const res = await fetch('/api/admin/product-types/order/', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids }),
    }).catch(() => null);
    say(res?.ok ? 'Orden guardado. Así salen los filtros en la tienda.' : 'No se pudo guardar el orden. Recarga e inténtalo de nuevo.');
  });
</script>
