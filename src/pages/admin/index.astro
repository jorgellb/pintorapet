---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { hasSupabase } from '@/lib/server/env';
import { getSessionUser, isActiveAdmin } from '@/lib/server/adminAuth';
import { createUserServerClient } from '@/lib/server/supabase';
import { loadOverview } from '@/lib/server/admin/overview';
import {
  chipClass,
  commissionLabel,
  euros,
  fulfillmentLabel,
  paymentLabel,
  shortDate,
  workCategoryLabel,
} from '@/lib/admin/labels';

export const prerender = false;

if (!hasSupabase()) return Astro.redirect('/admin/login/');

const session = await getSessionUser(Astro.cookies, Astro.request);

if (Astro.request.method === 'POST' && session) {
  const form = await Astro.request.formData();
  if (form.get('action') === 'signout') {
    const client = createUserServerClient(Astro.cookies, Astro.request);
    await client?.auth.signOut();
    return Astro.redirect('/admin/login/');
  }
}

if (!session) return Astro.redirect('/admin/login/');
const adminOk = await isActiveAdmin(session.client, session.user.id);

const overview = adminOk ? await loadOverview(session.client) : null;

const hour = Number(
  new Intl.DateTimeFormat('es-ES', { hour: 'numeric', hourCycle: 'h23', timeZone: 'Europe/Madrid' }).format(
    new Date(),
  ),
);
const greeting = hour < 13 ? 'Buenos días' : hour < 20 ? 'Buenas tardes' : 'Buenas noches';
const today = new Intl.DateTimeFormat('es-ES', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Madrid',
}).format(new Date());

const maxDay = Math.max(1, ...(overview?.visits.days.map((d) => d.visits) ?? [0]));
const trend = overview
  ? overview.visits.thisWeek - overview.visits.lastWeek
  : 0;
const setupDone = overview?.setup.filter((s) => s.ok).length ?? 0;
---

<AdminLayout title="Inicio" email={adminOk ? session.user.email : null}>
  {
    !adminOk || !overview ? (
      <div class="panel">
        <h1>Sin acceso al panel</h1>
        <p class="hint">
          Has entrado como <strong>{session.user.email}</strong>. Esta cuenta todavía
          no figura como administradora del estudio.
        </p>
        <form method="post">
          <input type="hidden" name="action" value="signout" />
          <button type="submit" class="btn--quiet">Cerrar sesión</button>
        </form>
      </div>
    ) : (
      <>
        <header class="hello">
          <p class="hello__date">{today}</p>
          <h1>{greeting}</h1>
        </header>

        <div class="sec-head sec-head--wall">
          <h2>Últimas fichas de obra</h2>
          <span class="sec-head__links">
            <a href="/admin/work/" class="hint">Ver todas</a>
            <a href="/admin/work/new/" class="btn btn--quiet">Nueva ficha</a>
          </span>
        </div>
        <section class="wall" aria-label="Últimas fichas de obra">
          {overview.wall.map((piece, index) => (
            <a class="wall__piece" href={`/admin/work/${piece.id}/`} style={`--i:${index}`}>
              <span class="wall__frame">
                {piece.src ? (
                  <img src={piece.src} alt="" decoding="async" />
                ) : (
                  <span class="wall__blank">Sin imagen</span>
                )}
              </span>
              <span class="wall__label">
                <em>{piece.title}</em>
                <span>
                  {workCategoryLabel(piece.category)}
                  {!piece.published && ' · oculta'}
                  {piece.needsText && <span class="wall__dot" title="Sin descripción" />}
                </span>
              </span>
            </a>
          ))}
        </section>

        <div class="grid">
          <section class="panel todo">
            <h2>Pendiente</h2>
            {overview.todos.length === 0 ? (
              <p class="hint">Todo al día. Puedes dedicarte a dibujar.</p>
            ) : (
              <ul>
                {overview.todos.map((todo) => (
                  <li>
                    <span class={`todo__mark todo__mark--${todo.tone}`} aria-hidden="true" />
                    <span class="todo__text">{todo.text}</span>
                    <a class="btn btn--quiet" href={todo.href}>
                      {todo.action}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="panel visits">
            <div class="visits__head">
              <h2>Visitas</h2>
              <a href="/admin/analytics/?days=7" class="hint">Ver detalle</a>
            </div>
            <p class="visits__big">
              <strong>{overview.visits.thisWeek}</strong>
              <span>
                en los últimos 7 días
                <br />
                {trend === 0
                  ? 'igual que la semana anterior'
                  : trend > 0
                    ? `${trend} más que la semana anterior`
                    : `${-trend} menos que la semana anterior`}
              </span>
            </p>
            <ol class="bars" aria-label="Visitas por día">
              {overview.visits.days.map((day) => (
                <li title={`${day.visits} visitas`}>
                  <span class="bars__n">{day.visits || ''}</span>
                  <span class="bars__bar" style={`--h:${(day.visits / maxDay) * 100}%`} />
                  <span class="bars__d">{day.label}</span>
                </li>
              ))}
            </ol>
            <p class="hint">{overview.visits.views} páginas vistas por quien aceptó la medición.</p>
          </section>
        </div>

        <section class="quick" aria-label="Accesos rápidos">
          <a class="quick__item" href="/admin/work/new/">
            <strong>Nueva ficha de obra</strong>
            <span>Retrato, foto de referencia y proceso</span>
          </a>
          <a class="quick__item" href="/admin/gallery/new/">
            <strong>Nueva pieza de galería</strong>
            <span>Personas, arquitectura o ilustración</span>
          </a>
          <a class="quick__item" href="/admin/media/#subir">
            <strong>Subir imágenes</strong>
            <span>{overview.counts.media} en la biblioteca</span>
          </a>
          <button type="button" class="quick__item" data-sync>
            <strong>Sincronizar catálogo</strong>
            <span data-sync-status>Enviar la tienda a Google y Meta</span>
          </button>
        </section>

        <section class="inventory" aria-label="En la web">
          <a href="/admin/work/">
            <strong>{overview.counts.worksPublished}</strong>
            <span>fichas de obra publicadas</span>
          </a>
          <a href="/admin/gallery/">
            <strong>{overview.counts.gallery}</strong>
            <span>piezas en la galería extra</span>
          </a>
          <a href="/admin/products/">
            <strong>{overview.counts.products}</strong>
            <span>
              productos · {overview.counts.productsOnSale} a la venta
            </span>
          </a>
          <a href="/admin/media/">
            <strong>{overview.counts.media}</strong>
            <span>imágenes en Medios</span>
          </a>
        </section>

        <div class="grid grid--even">
          <section>
            <div class="sec-head">
              <h2>Encargos recientes</h2>
              <a href="/admin/commissions/" class="hint">Todos</a>
            </div>
            {overview.commissions.length === 0 ? (
              <p class="empty">Los encargos que lleguen desde el formulario aparecerán aquí.</p>
            ) : (
              <div class="table-wrap">
                <table>
                  <tbody>
                    {overview.commissions.map((row) => {
                      const label = commissionLabel(row.status);
                      return (
                        <tr>
                          <td>
                            <a href={`/admin/commissions/#${row.reference}`}>{row.contact_name}</a>
                            <div class="muted">{row.subjects ?? row.reference}</div>
                          </td>
                          <td>
                            <span class={chipClass(label.tone)}>{label.text}</span>
                          </td>
                          <td class="num muted">{shortDate(row.created_at)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          <section>
            <div class="sec-head">
              <h2>Pedidos recientes</h2>
              <a href="/admin/orders/" class="hint">Todos</a>
            </div>
            {overview.orders.length === 0 ? (
              <p class="empty">Los pedidos de la tienda aparecerán aquí en cuanto actives la venta.</p>
            ) : (
              <div class="table-wrap">
                <table>
                  <tbody>
                    {overview.orders.map((row) => {
                      const pay = paymentLabel(row.payment_status);
                      const ship = fulfillmentLabel(row.fulfillment_status);
                      return (
                        <tr>
                          <td>
                            <code>{row.reference}</code>
                            <div class="muted">{row.customer_email ?? '—'}</div>
                          </td>
                          <td>
                            <span class={chipClass(pay.tone)}>{pay.text}</span>{' '}
                            {row.payment_status === 'paid' && (
                              <span class={chipClass(ship.tone)}>{ship.text}</span>
                            )}
                          </td>
                          <td class="num">{euros(row.total_cents)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>

        <section class="setup">
          <div class="sec-head">
            <h2>Puesta en marcha</h2>
            <span class="hint">
              {setupDone} de {overview.setup.length} listos
            </span>
          </div>
          <ul>
            {overview.setup.map((item) => (
              <li class={item.ok ? 'is-ok' : undefined}>
                <span class="setup__tick" aria-hidden="true">
                  {item.ok ? '✓' : ''}
                </span>
                {item.ok ? (
                  <span>{item.label}</span>
                ) : (
                  <a href={item.href}>{item.label}</a>
                )}
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }
</AdminLayout>

<style>
  .hello {
    margin-bottom: 2rem;
  }

  .hello__date {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .hello__date::first-letter {
    text-transform: uppercase;
  }

  .hello h1 {
    font-size: clamp(2.4rem, 4.2vw, 3.6rem);
    font-style: italic;
  }

  /* Salon hang: the latest drawings at slightly different heights,
     each with a gallery label underneath */
  /* One row only: pieces that do not fit drop into zero-height rows and
     are clipped, so the hang adapts to the width without scrolling. */
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    grid-template-rows: auto;
    grid-auto-rows: 0;
    column-gap: 1.75rem;
    row-gap: 0;
    align-items: start;
    margin: 0 -1.5rem 2.5rem;
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
  }

  .wall__piece {
    display: grid;
    gap: 0.7rem;
    padding-bottom: 1.75rem;
    text-decoration: none;
    margin-top: calc(mod(var(--i), 3) * 0.9rem);
  }

  .sec-head--wall h2 {
    margin-top: 0;
  }

  .sec-head__links {
    display: flex;
    flex: none;
    align-items: center;
    gap: 1rem;
    white-space: nowrap;
  }

  .sec-head__links .btn {
    min-height: 2.1rem;
    padding: 0.35rem 0.9rem;
    font-size: 0.84rem;
  }

  .wall__frame {
    display: block;
    aspect-ratio: 4 / 5;
    padding: 0.45rem;
    background: var(--sheet);
    box-shadow: var(--shadow-art);
    transition:
      transform 420ms var(--ease-out),
      box-shadow 420ms var(--ease-out);
  }

  .wall__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--paper-deep);
  }

  .wall__blank {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--paper-deep);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .wall__piece:hover .wall__frame,
  .wall__piece:focus-visible .wall__frame {
    transform: translateY(-4px) rotate(-0.4deg);
  }

  .wall__label {
    display: grid;
    gap: 0.1rem;
    padding-left: 0.1rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .wall__label em {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
  }

  .wall__dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-left: 0.4rem;
    border-radius: 50%;
    background: var(--a-warn);
    vertical-align: 0.1em;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .grid--even {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 0.5rem;
  }

  .panel h2 {
    margin: 0;
  }

  .todo ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .todo li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .todo li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .todo__mark {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }

  .todo__mark--warn {
    background: var(--a-warn);
  }

  .todo__mark--info {
    background: var(--accent);
    opacity: 0.55;
  }

  .todo .btn {
    min-height: 2.1rem;
    padding: 0.35rem 0.9rem;
    font-size: 0.84rem;
  }

  .visits__head,
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .sec-head h2 {
    margin: 2.25rem 0 0.75rem;
  }

  .visits__big {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin: 0;
  }

  .visits__big strong {
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .visits__big span {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.45rem;
    height: 7.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bars li {
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-items: end;
    justify-items: center;
    gap: 0.25rem;
  }

  .bars__bar {
    width: 100%;
    height: max(var(--h), 3px);
    border-radius: 3px 3px 0 0;
    background: var(--ink);
    opacity: 0.82;
    transform-origin: bottom;
    animation: grow 700ms var(--ease-out) both;
  }

  .bars li:last-child .bars__bar {
    background: var(--accent);
    opacity: 1;
  }

  .bars__n {
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .bars__d {
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: capitalize;
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  .quick {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 0;
  }

  .quick__item,
  .quick button.quick__item {
    display: grid;
    gap: 0.2rem;
    justify-items: start;
    align-content: start;
    min-height: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--a-radius);
    background: var(--sheet);
    color: var(--ink);
    text-align: left;
    text-decoration: none;
    transition:
      border-color var(--dur-ui) var(--ease-soft),
      transform var(--dur-ui) var(--ease-soft);
  }

  .quick__item:hover,
  .quick button.quick__item:hover {
    border-color: var(--ink);
    background: var(--sheet);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .quick__item strong {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .quick__item span {
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 400;
  }

  .inventory {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 2.25rem 0 0;
    border-block: 1px solid var(--line);
  }

  .inventory a {
    display: grid;
    gap: 0.1rem;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
  }

  .inventory a + a {
    border-left: 1px solid var(--line);
  }

  .inventory a:hover {
    background: var(--sheet);
  }

  .inventory strong {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .inventory span {
    color: var(--muted);
    font-size: 0.86rem;
  }

  .setup ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .setup li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
  }

  .setup__tick {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: 0.75rem;
  }

  .setup li.is-ok .setup__tick {
    border-color: var(--success);
    background: var(--success);
    color: var(--light);
  }

  .setup li.is-ok span:last-child {
    color: var(--muted);
  }

  @media (max-width: 70rem) {
    .quick,
    .inventory {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .inventory a:nth-child(3) {
      border-left: 0;
    }

    .inventory a:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 52rem) {
    .grid,
    .grid--even {
      grid-template-columns: 1fr;
    }

    .setup ul {
      grid-template-columns: 1fr;
    }

    .wall__piece {
      margin-top: 0;
    }
  }
</style>

<script>
  const sync = document.querySelector('[data-sync]');
  const status = document.querySelector('[data-sync-status]');
  if (sync instanceof HTMLButtonElement && status instanceof HTMLElement) {
    sync.addEventListener('click', async () => {
      sync.disabled = true;
      status.textContent = 'Sincronizando…';
      try {
        const res = await fetch('/api/admin/catalog-sync/', { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        const google = data.google?.message ?? 'Google sin respuesta.';
        const meta = data.meta?.message ?? 'Meta sin respuesta.';
        status.textContent = `${google} ${meta}`;
      } catch {
        status.textContent = 'No se pudo conectar. Inténtalo de nuevo.';
      }
      sync.disabled = false;
    });
  }
</script>
