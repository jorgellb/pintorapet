---
import { loadWorks } from '@/lib/content/editorial';
import PublicLayout from '@/layouts/PublicLayout.astro';
import PhotoDrawingCompare from '@/components/art/PhotoDrawingCompare.astro';
import { t, type Locale } from '@/i18n';
import { localizedPath, workPath } from '@/i18n/routes';
import { formatEur } from '@/lib/domain/money';
import { loadPublicCatalog, topLevelProducts } from '@/lib/catalog/loadProducts';
import { getAboutImages } from '@/lib/content/siteExtras';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const dict = t(locale);
const products = topLevelProducts((await loadPublicCatalog(locale)).products);
const aboutPortrait = (await getAboutImages())[0]?.publicUrl ?? null;

const works = await loadWorks();
type Work = (typeof works)[number];

const srcOf = (w: Work, role: 'drawing' | 'reference_photo') =>
  w.data.assets.find((a) => a.role === role && a.src)?.src ?? null;

const hero = works.find((w) => w.id === 'frankie') ?? works.find((w) => srcOf(w, 'drawing'));
const heroDrawing = hero ? srcOf(hero, 'drawing') : null;
const heroPhoto = hero ? srcOf(hero, 'reference_photo') : null;

const collage = ['millie-cat', 'moquitos', 'tida', 'nara']
  .map((id) => works.find((w) => w.id === id && srcOf(w, 'drawing')))
  .filter((w): w is Work => w !== undefined);

// Headline breaks around the artwork: first clause above, the rest below.
const [titleTop, titleBottom] = (() => {
  const m = dict.home.heroTitle.match(/^(.+?[.,])\s+(.+)$/);
  return m ? [m[1], m[2]] : [dict.home.heroTitle, ''];
})();

const pair =
  works.find((w) => w.id === 'sox-kira' && srcOf(w, 'drawing') && srcOf(w, 'reference_photo')) ??
  works.find((w) => w.id !== hero?.id && srcOf(w, 'drawing') && srcOf(w, 'reference_photo'));

const salon = works
  .filter((w) => w.id !== hero?.id && w.id !== pair?.id && srcOf(w, 'drawing'))
  .slice(0, 9);

const shop = [
  products.find((p) => p.category === 'mugs'),
  products.find((p) => p.category === 'greeting-cards'),
  products.find((p) => p.category === 'coasters'),
].filter((p) => p !== undefined);
---

<PublicLayout locale={locale} title={dict.nav.home} description={dict.home.heroLead}>
  <section class="hero">
    <div class="site-shell hero__grid">
      <p class="hero__eyebrow">
        {es ? 'Retratos de mascotas a grafito' : 'Pet portraits in graphite'}
        <span aria-hidden="true">·</span>
        Meili Stringfellow
      </p>
      <h1 class="hero__title display">
        <span class="hero__line hero__line--top">{titleTop}</span>
        {titleBottom && <span class="hero__line hero__line--bottom">{titleBottom}</span>}
      </h1>

      <div class="hero__art collage" data-collage>
        {
          collage.map((w, i) => (
            <a
              class={`piece piece--${i + 1}`}
              href={workPath(locale, w.data.pathSlugs[locale])}
              style={`--i:${i + 1}`}
            >
              <span class="piece__sheet">
                <img
                  src={srcOf(w, 'drawing')!}
                  alt={w.data.title[locale]}
                  loading="eager"
                  decoding="async"
                  style={`view-transition-name: work-${w.data.id}`}
                />
              </span>
            </a>
          ))
        }

        {
          heroPhoto && (
            <figure class="piece piece--photo" style="--i:5">
              <span class="piece__sheet polaroid">
                <img
                  src={heroPhoto}
                  alt={es ? 'Fotografía original de Frankie' : 'Original photograph of Frankie'}
                  loading="eager"
                  decoding="async"
                />
                <figcaption>{es ? 'la foto de Frankie' : 'Frankie’s photo'}</figcaption>
              </span>
            </figure>
          )
        }

        <svg class="collage__arrow" viewBox="0 0 120 80" aria-hidden="true">
          <path d="M8 74 C 18 30, 60 6, 110 20" pathLength="1"></path>
          <path d="M95 8 L110 20 L93 28" pathLength="1"></path>
        </svg>

        <div class="piece piece--hero" style="--i:0">
          <div class="hero__sheet" data-tilt>
            {
              heroDrawing && (
                <img
                  src={heroDrawing}
                  alt={hero ? hero.data.title[locale] : ''}
                  width="1551"
                  height="1080"
                  fetchpriority="high"
                  decoding="async"
                  style={hero ? `view-transition-name: work-${hero.data.id}` : undefined}
                />
              )
            }
            <span class="hero__glare" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <div class="hero__aside">
        <p class="hero__lead">{dict.home.heroLead}</p>
        <div class="hero__cta">
          <a class="btn" href={localizedPath(locale, 'commissions')}>{dict.home.ctaCommission}</a>
          <a class="btn btn--ghost" href={localizedPath(locale, 'shop')}>{dict.nav.shop}</a>
        </div>
        {
          hero && (
            <p class="plaque">
              <span class="plaque__label">{es ? 'En la pared' : 'On the wall'}</span>
              <a href={workPath(locale, hero.data.pathSlugs[locale])}>{hero.data.title[locale]}</a>
              <span>{es ? 'grafito sobre papel' : 'graphite on paper'}</span>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="corridor" aria-labelledby="corridor-title" data-corridor>
    <div class="corridor__sticky">
      <ul class="corridor__track" data-corridor-track>
        <li class="corridor__intro">
          <h2 id="corridor-title" class="display corridor__title">{dict.home.latest}</h2>
          <p class="muted">
            {es
              ? 'Cada retrato empieza con una fotografía y termina, semanas después, en papel.'
              : 'Every portrait begins with a photograph and ends, weeks later, on paper.'}
          </p>
          <a class="link" href={localizedPath(locale, 'work')}>
            {es ? 'Ver toda la obra' : 'See all the work'}
          </a>
          <p class="corridor__hint">
            <span>{es ? 'Desliza a la derecha' : 'Swipe right'}</span>
            <svg viewBox="0 0 72 16" aria-hidden="true">
              <path d="M1 8 H58"></path>
              <path d="M50 2 L62 8 L50 14"></path>
            </svg>
          </p>
        </li>
        {
          salon.map((w) => (
            <li class="corridor__item">
              <a href={workPath(locale, w.data.pathSlugs[locale])}>
                <img
                  src={srcOf(w, 'drawing')!}
                  alt={w.data.title[locale]}
                  loading="eager"
                  decoding="async"
                  style={`view-transition-name: work-${w.data.id}`}
                />
                <span class="corridor__label">{w.data.title[locale]}</span>
              </a>
            </li>
          ))
        }
        <li class="corridor__end">
          <a class="display" href={localizedPath(locale, 'work')}>
            {es ? 'Toda la obra' : 'All the work'}
          </a>
        </li>
      </ul>
    </div>
  </section>

  {
    pair && (
      <section class="section process" aria-labelledby="process-title">
        <div class="site-shell process__grid">
          <div class="process__copy">
            <h2 id="process-title" class="display h2-display">{dict.home.fromPhoto}</h2>
            <p>
              {es
                ? 'Envías tus fotografías favoritas. Meili estudia la luz, el pelaje y, sobre todo, la mirada, y lo dibuja a mano, trazo a trazo, en grafito.'
                : 'You send your favourite photographs. Meili studies the light, the coat and above all the gaze, then draws it by hand, stroke by stroke, in graphite.'}
            </p>
            <ul class="process__prices">
              <li>{dict.commissions.priceA4}</li>
              <li>{dict.commissions.priceA3}</li>
              <li>{dict.commissions.priceExtra}</li>
            </ul>
            <a class="btn" href={localizedPath(locale, 'commissions')}>{dict.home.ctaCommission}</a>
          </div>
          <div class="process__compare">
            <PhotoDrawingCompare
              photoSrc={srcOf(pair, 'reference_photo')!}
              drawingSrc={srcOf(pair, 'drawing')!}
              photoAlt={`${pair.data.title[locale]}: ${dict.art.photo}`}
              drawingAlt={`${pair.data.title[locale]}: ${dict.art.drawing}`}
              photoLabel={dict.art.photo}
              drawingLabel={dict.art.drawing}
              hint={dict.art.compareHint}
            />
          </div>
        </div>
      </section>
    )
  }

  {
    shop.length > 0 && (
      <section class="section boutique" aria-labelledby="boutique-title">
        <div class="site-shell">
          <header class="boutique__head">
            <h2 id="boutique-title" class="display h2-display">
              {es ? 'Su arte, para tu casa' : 'Her art, for your home'}
            </h2>
            <p class="muted">{dict.shop.lead}</p>
          </header>
          <ul class="boutique__grid">
            {shop.map((p, i) => (
              <li class={i === 0 ? 'boutique__item boutique__item--feature' : 'boutique__item'}>
                <a href={localizedPath(locale, 'shop', p.slug)}>
                  {p.coverImageUrl ? (
                    <img src={p.coverImageUrl} alt={p.title} loading="lazy" decoding="async" />
                  ) : (
                    <span class="boutique__ph" aria-hidden="true" />
                  )}
                  <span class="boutique__meta">
                    <span class="display boutique__name">{p.title}</span>
                    <span class="price">{formatEur(p.priceCents, locale)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link" href={localizedPath(locale, 'shop')}>
            {es ? 'Ver la tienda' : 'Visit the shop'}
          </a>
        </div>
      </section>
    )
  }

  <section class="section artist" aria-labelledby="artist-title">
    <div class="site-shell artist__grid">
      {
        aboutPortrait && (
          <img
            class="artist__photo"
            src={aboutPortrait}
            alt={es ? 'Meili con sus dibujos' : 'Meili with her drawings'}
            loading="lazy"
            decoding="async"
          />
        )
      }
      <div class="artist__copy">
        <h2 id="artist-title" class="display h2-display">Meili Stringfellow</h2>
        <p>
          {es
            ? 'Desde su estudio en España, Meili dibuja retratos de mascotas a partir de fotografías, y también personas e ilustraciones para negocios y publicaciones.'
            : 'From her studio in Spain, Meili draws pet portraits from photographs, as well as people and illustrations for businesses and publications.'}
        </p>
        <a class="link" href={localizedPath(locale, 'about')}>
          {es ? 'Conoce a Meili' : 'Meet Meili'}
        </a>
      </div>
    </div>
  </section>

  <section class="section invite">
    <div class="site-shell invite__inner">
      <h2 class="display invite__title">
        {es ? '¿Dibujamos a tu compañero?' : 'Shall we draw your companion?'}
      </h2>
      <div class="invite__cta">
        <a class="btn" href={localizedPath(locale, 'commissions')}>{dict.home.ctaCommission}</a>
        <a class="link" href={localizedPath(locale, 'contact')}>{dict.nav.contact}</a>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.35em;
    transition: text-decoration-color var(--dur-ui) var(--ease-soft);
  }

  .link:hover {
    text-decoration-color: var(--ink);
  }

  /* ——— Hero: the drawing appears on the wall, line by line ——— */
  .hero {
    position: relative;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(4rem, 8vw, 7rem);
    overflow: clip;
  }

  .hero::before {
    /* gallery spotlight falling on the wall */
    content: '';
    position: absolute;
    inset: -20% 0 auto;
    height: 120%;
    background: radial-gradient(ellipse 45% 55% at 62% 40%, #fff 0%, transparent 70%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__eyebrow {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    animation: rise 1s var(--ease-out) 0.1s both;
  }

  .hero__eyebrow::before {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: currentColor;
  }

  .hero__title {
    margin: 0;
    display: contents;
  }

  .hero__line {
    display: block;
    position: relative;
    z-index: 2;
    font-size: clamp(3rem, 6.5vw, 8.25rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--ink);
    white-space: nowrap;
    text-shadow:
      0 0 24px var(--paper),
      0 0 48px var(--paper);
    animation: rise 1.3s var(--ease-out) 0.25s both;
  }

  .hero__line--bottom {
    font-style: italic;
    font-weight: 400;
    color: var(--accent-deep);
    animation-delay: 1.5s;
  }

  /* ——— Collage: sheets pinned to the studio wall at different depths ——— */
  .collage {
    --px: 0;
    --py: 0;
    --sy: 0;
    position: relative;
    aspect-ratio: 16 / 11;
  }

  .piece {
    --r: 0deg;
    --d: 20;
    --ar: 4 / 5;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    margin: 0;
    z-index: var(--z, 2);
    rotate: var(--r);
    translate: calc(var(--px) * var(--d) * 1px)
      calc(var(--py) * var(--d) * 1px - var(--sy) * var(--d) * 0.012px);
    transition:
      translate 800ms var(--ease-out),
      rotate 500ms var(--ease-out),
      scale 500ms var(--ease-out);
    animation: drop 1.1s cubic-bezier(0.2, 0.9, 0.25, 1.12) calc(0.2s + var(--i) * 0.16s) both;
  }

  .piece__sheet {
    position: relative;
    display: block;
    background: var(--sheet);
    padding: clamp(0.3rem, 0.7vw, 0.65rem);
    box-shadow: var(--shadow-art);
  }

  /* washi tape holding each sheet */
  .piece__sheet::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: -0.7rem;
    left: 50%;
    width: 38%;
    height: 1.35rem;
    translate: -50% 0;
    rotate: -3deg;
    background: rgb(214 220 232 / 0.72);
    box-shadow: 0 1px 2px rgb(22 23 26 / 0.08);
    -webkit-mask-image: linear-gradient(90deg, transparent 0 2%, #000 2% 98%, transparent 98%);
    mask-image: linear-gradient(90deg, transparent 0 2%, #000 2% 98%, transparent 98%);
  }

  .piece img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ar);
    object-fit: cover;
    object-position: 50% 35%;
    box-shadow: none;
    border-radius: 0;
  }

  a.piece:hover,
  a.piece:focus-visible {
    z-index: 8;
    scale: 1.05;
    rotate: calc(var(--r) * 0.3);
  }

  a.piece:focus-visible {
    outline: none;
  }

  a.piece:focus-visible .piece__sheet {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .piece--1 {
    --x: -3%;
    --y: 4%;
    --w: 21%;
    --r: -5deg;
    --d: 30;
    --ar: 3 / 4;
  }

  .piece--2 {
    --x: 75%;
    --y: -4%;
    --w: 24%;
    --r: 4deg;
    --d: 22;
  }

  .piece--3 {
    --x: 79%;
    --y: 50%;
    --w: 21%;
    --r: -3deg;
    --d: 34;
    --z: 3;
  }

  .piece--4 {
    --x: 53%;
    --y: 69%;
    --w: 18%;
    --r: 6deg;
    --d: 42;
    --ar: 1;
    --z: 6;
  }

  .piece--photo {
    --x: 2%;
    --y: 50%;
    --w: 20%;
    --r: -8deg;
    --d: 26;
    --ar: 1;
    --z: 6;
  }

  .polaroid {
    padding-bottom: clamp(2rem, 3.2vw, 2.8rem);
  }

  .polaroid figcaption {
    position: absolute;
    inset: auto 0 clamp(0.45rem, 0.8vw, 0.8rem);
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    color: var(--ink-soft);
  }

  .piece--hero {
    --x: 19%;
    --y: 13%;
    --w: 58%;
    --r: -1deg;
    --d: 8;
    --z: 4;
  }

  .collage__arrow {
    position: absolute;
    z-index: 7;
    left: 22%;
    top: 68%;
    width: 9%;
    overflow: visible;
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .collage__arrow path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ink 1.1s var(--ease-out) 3.3s forwards;
  }

  .collage__arrow path + path {
    animation-duration: 0.4s;
    animation-delay: 4.3s;
  }

  @keyframes ink {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-70px) rotate(-7deg) scale(1.1);
    }
    55% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__sheet {
    position: relative;
    background: var(--sheet);
    box-shadow: var(--shadow-art);
    padding: clamp(0.5rem, 1.2vw, 1rem);
  }

  .hero__sheet img {
    width: 100%;
    aspect-ratio: auto;
    object-fit: contain;
    box-shadow: none;
    border-radius: 0;
    /* graphite appears as if drawn, left to right */
    -webkit-mask-image: linear-gradient(100deg, #000 42%, transparent 58%);
    mask-image: linear-gradient(100deg, #000 42%, transparent 58%);
    -webkit-mask-size: 280% 100%;
    mask-size: 280% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: draw 2.8s cubic-bezier(0.45, 0.05, 0.25, 1) 0.9s both;
  }

  .hero__aside {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 1.6rem;
    max-width: 29rem;
    animation: rise 1.2s var(--ease-out) 1.9s both;
  }

  .hero__lead {
    margin: 0;
    font-size: clamp(1.05rem, 1.15vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .plaque {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .plaque__label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .plaque a {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-ui) var(--ease-soft);
  }

  .plaque a:hover {
    text-decoration-color: currentColor;
  }

  .plaque a + span::before {
    content: '— ';
  }

  @keyframes draw {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
      filter: blur(3px) contrast(0.6);
    }
    70% {
      filter: blur(0) contrast(0.9);
    }
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
      filter: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__sheet img {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .piece {
      animation: none;
      translate: none;
    }

    .collage__arrow path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 63.99rem) {
    .hero {
      padding-top: 1.25rem;
    }

    .hero__grid {
      gap: 0;
    }

    .hero__eyebrow {
      order: 0;
      margin-bottom: 1rem;
      font-size: 0.7rem;
    }

    .hero__eyebrow span {
      display: none;
    }

    .hero__line {
      font-size: clamp(2.8rem, 13.5vw, 6rem);
    }

    .hero__line--top {
      order: 1;
    }

    .hero__art {
      order: 2;
      position: relative;
      z-index: 1;
      margin-inline: -0.25rem;
    }

    .collage {
      aspect-ratio: 1 / 1.12;
      margin-block: 0.9rem 1.6rem;
    }

    .hero__sheet {
      padding: 0.45rem;
    }

    .piece__sheet::before {
      top: -0.55rem;
      height: 1rem;
    }

    .piece--hero {
      --x: 5%;
      --y: 21%;
      --w: 90%;
      --r: -1.5deg;
    }

    .piece--1 {
      --x: -4%;
      --y: 0%;
      --w: 31%;
    }

    .piece--2 {
      --x: 69%;
      --y: -1%;
      --w: 33%;
    }

    .piece--3 {
      --x: 69%;
      --y: 62%;
      --w: 33%;
      --z: 5;
    }

    .piece--4 {
      --x: 38%;
      --y: 75%;
      --w: 27%;
    }

    .piece--photo {
      --x: -3%;
      --y: 54%;
      --w: 36%;
    }

    .collage__arrow {
      display: none;
    }

    .hero__line--bottom {
      order: 1;
      text-align: right;
    }

    .hero__aside {
      order: 3;
      gap: 1.4rem;
      margin-top: 0.75rem;
      max-width: none;
    }

    .hero__cta {
      display: grid;
      grid-template-columns: 1fr auto;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      display: grid;
      align-items: center;
      padding-top: 0;
      min-height: calc(100svh - 12.5rem);
    }

    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1fr auto auto auto auto 1fr;
      column-gap: 2rem;
      row-gap: 0;
      align-items: start;
    }

    .hero__eyebrow {
      grid-column: 1 / 7;
      grid-row: 2;
      margin-bottom: clamp(1.25rem, 2vw, 2rem);
    }

    .hero__line--top {
      grid-column: 1 / 8;
      grid-row: 3;
    }

    /* the italic clause steps in, like a second line of verse */
    .hero__line--bottom {
      grid-column: 1 / 10;
      grid-row: 4;
      padding-left: 0.6em;
    }

    .hero__aside {
      grid-column: 1 / 6;
      grid-row: 5;
      margin-top: clamp(1.75rem, 3vw, 2.75rem);
    }

    .hero__art {
      grid-column: 6 / 13;
      grid-row: 1 / -1;
      align-self: center;
      justify-self: end;
      width: min(100%, calc(66svh * 16 / 11));
      z-index: 1;
    }
  }

  .boutique__head {
    max-width: 38rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ——— Hero tilt: the sheet answers the pointer, light slides across ——— */
  [data-tilt] {
    --rx: 0deg;
    --ry: 0deg;
    --gx: 30%;
    --gy: 20%;
    --glare: 0;
    transform: perspective(1600px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 900ms var(--ease-out);
    will-change: transform;
  }

  [data-tilt].is-tilting {
    transition: transform 120ms linear;
  }

  .hero__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--gx) var(--gy),
      rgb(255 255 255 / 0.55),
      rgb(255 255 255 / 0) 45%
    );
    mix-blend-mode: soft-light;
    opacity: var(--glare);
    transition: opacity 600ms var(--ease-out);
  }

  /* ——— Corridor: drawings pass by as the visitor walks (scrolls) ——— */
  .corridor {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .corridor__track {
    list-style: none;
    margin: 0;
    display: flex;
    align-items: flex-end;
    gap: clamp(1.25rem, 3vw, 3.5rem);
    padding: 1rem max(1.25rem, calc((100vw - var(--max-editorial)) / 2)) 2.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .corridor__track::-webkit-scrollbar {
    display: none;
  }

  .corridor__intro {
    flex: 0 0 min(80vw, 24rem);
    align-self: center;
    display: grid;
    gap: 1rem;
    justify-items: start;
    scroll-snap-align: start;
  }

  .corridor__title {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.6rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .corridor__intro p {
    margin: 0;
    font-size: 1.08rem;
    max-width: 22rem;
  }

  .corridor__item {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  .corridor__item:nth-child(even) {
    margin-bottom: 3.5rem;
  }

  .corridor__item a {
    display: grid;
    gap: 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .corridor__item img {
    height: min(58svh, 30rem);
    width: auto;
    max-width: 82vw;
    object-fit: contain;
    padding: clamp(0.45rem, 1vw, 0.8rem);
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out);
  }

  .corridor__item a:hover img {
    transform: translateY(-8px);
    box-shadow:
      0 1px 2px rgb(22 23 26 / 0.06),
      0 20px 34px -12px rgb(22 23 26 / 0.16),
      0 60px 90px -36px rgb(22 23 26 / 0.28);
  }

  .corridor__label {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
  }

  .corridor__end {
    flex: 0 0 auto;
    align-self: center;
    padding-inline: 2rem 1rem;
  }

  .corridor__end a {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-style: italic;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .corridor__sticky {
    position: relative;
  }

  /* On touch (and reduced motion) the walk is a sideways swipe, so say so */
  .corridor__hint {
    display: none;
    margin: 0.15rem 0 0;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--ink);
    transition: opacity 400ms var(--ease-out);
  }

  .corridor.needs-swipe .corridor__hint {
    display: flex;
  }

  .corridor__hint svg {
    width: 3.4rem;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: point 1.5s var(--ease-out) infinite;
  }

  .corridor.needs-swipe .corridor__sticky::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    bottom: 0;
    width: 4.5rem;
    background: linear-gradient(90deg, transparent, var(--paper) 86%);
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
  }

  .corridor.is-explored .corridor__hint,
  .corridor.is-explored .corridor__sticky::after {
    opacity: 0;
  }

  @keyframes point {
    0%,
    100% {
      transform: translateX(0);
    }
    55% {
      transform: translateX(9px);
    }
  }

  @media (max-width: 63.99rem) {
    .corridor__intro {
      flex-basis: 62vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corridor__hint svg {
      animation: none;
    }
  }

  /* Pinned on desktop: vertical scroll drives the horizontal walk */
  .corridor.is-pinned {
    padding-block: 0;
    height: var(--corridor-h, 300vh);
  }

  .corridor.is-pinned .corridor__sticky {
    position: sticky;
    top: var(--header-h, 5.5rem);
    height: calc(100svh - var(--header-h, 5.5rem));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .corridor.is-pinned .corridor__track {
    overflow: visible;
    scroll-snap-type: none;
    transform: translate3d(var(--corridor-x, 0px), 0, 0);
    will-change: transform;
  }

  /* ——— Process ——— */
  .process {
    background: var(--paper-deep);
  }

  .process__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .process__copy p {
    max-width: 34rem;
    font-size: 1.12rem;
    color: var(--ink-soft);
  }

  .process__prices {
    list-style: none;
    margin: 1.75rem 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .process__compare :global(.compare__stage) {
    aspect-ratio: 3 / 2;
  }

  .process__compare :global(.compare__base),
  .process__compare :global(.compare__overlay) {
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .process__grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  /* ——— Boutique ——— */
  .boutique__grid {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .boutique__item a {
    display: grid;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .boutique__item img,
  .boutique__ph {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .boutique__ph {
    display: block;
    background: var(--paper-deep);
  }

  .boutique__item a:hover img {
    transform: scale(1.015);
  }

  .boutique__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .boutique__name {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  @media (min-width: 48rem) {
    .boutique__grid {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: auto auto;
    }

    .boutique__item--feature {
      grid-row: 1 / 3;
    }

    .boutique__item--feature img {
      aspect-ratio: 4 / 5;
    }

    .boutique__item:not(.boutique__item--feature) img {
      aspect-ratio: 4 / 3;
    }
  }

  /* ——— Artist ——— */
  .artist__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .artist__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    padding: 0.7rem;
  }

  .artist__copy p {
    max-width: 34rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  @media (min-width: 64rem) {
    .artist__grid {
      grid-template-columns: 5fr 6fr;
    }

    .artist__photo {
      max-width: 32rem;
    }
  }

  /* ——— Invite ——— */
  .invite {
    text-align: center;
    border-top: 1px solid var(--line);
  }

  .invite__title {
    margin: 0 auto 2rem;
    max-width: 14ch;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .invite__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
  }
</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 64rem) and (hover: hover) and (pointer: fine)');

  const art = document.querySelector<HTMLElement>('[data-tilt]');
  if (art) {
    art.addEventListener('pointermove', (e) => {
      if (calm.matches || !desktop.matches) return;
      const r = art.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      art.classList.add('is-tilting');
      art.style.setProperty('--ry', `${(x - 0.5) * 7}deg`);
      art.style.setProperty('--rx', `${(0.5 - y) * 5}deg`);
      art.style.setProperty('--gx', `${x * 100}%`);
      art.style.setProperty('--gy', `${y * 100}%`);
      art.style.setProperty('--glare', '1');
    });
    art.addEventListener('pointerleave', () => {
      art.classList.remove('is-tilting');
      art.style.setProperty('--rx', '0deg');
      art.style.setProperty('--ry', '0deg');
      art.style.setProperty('--glare', '0');
    });
  }

  const collage = document.querySelector<HTMLElement>('[data-collage]');
  const heroSection = collage?.closest<HTMLElement>('.hero');
  if (collage && heroSection) {
    let sframe = 0;
    heroSection.addEventListener('pointermove', (e) => {
      if (calm.matches || !desktop.matches) return;
      const r = heroSection.getBoundingClientRect();
      collage.style.setProperty('--px', (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(3));
      collage.style.setProperty('--py', (((e.clientY - r.top) / r.height - 0.5) * 2).toFixed(3));
    });
    heroSection.addEventListener('pointerleave', () => {
      collage.style.setProperty('--px', '0');
      collage.style.setProperty('--py', '0');
    });
    window.addEventListener(
      'scroll',
      () => {
        if (sframe || calm.matches) return;
        sframe = requestAnimationFrame(() => {
          sframe = 0;
          const y = Math.min(window.scrollY, heroSection.offsetHeight);
          collage.style.setProperty('--sy', String(Math.round(y)));
        });
      },
      { passive: true },
    );
  }

  const corridor = document.querySelector<HTMLElement>('[data-corridor]');
  const track = document.querySelector<HTMLElement>('[data-corridor-track]');
  if (corridor && track) {
    let distance = 0;
    let frame = 0;

    const header = document.querySelector<HTMLElement>('[data-site-header]');

    const layout = () => {
      const pin = desktop.matches && !calm.matches;
      corridor.classList.toggle('is-pinned', pin);
      corridor.classList.toggle('needs-swipe', !pin);
      if (!pin) {
        corridor.style.removeProperty('--corridor-h');
        track.style.removeProperty('--corridor-x');
        return;
      }
      const headerH = header?.offsetHeight ?? 0;
      corridor.style.setProperty('--header-h', `${headerH}px`);
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      corridor.style.setProperty('--corridor-h', `${window.innerHeight - headerH + distance}px`);
      update();
    };

    const update = () => {
      frame = 0;
      if (!corridor.classList.contains('is-pinned')) return;
      const headerH = header?.offsetHeight ?? 0;
      const start = corridor.getBoundingClientRect().top + window.scrollY - headerH;
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, distance)));
      track.style.setProperty('--corridor-x', `${-progress * distance}px`);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', layout);
    desktop.addEventListener('change', layout);
    calm.addEventListener('change', layout);
    track.querySelectorAll('img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', layout, { once: true });
    });
    layout();

    /* Teach the sideways swipe: a hint, and one small nudge when it comes into view */
    let explored = false;
    let nudged = false;
    let nudgeFrame = 0;
    let rest = 0;

    const explore = () => {
      if (explored) return;
      explored = true;
      cancelAnimationFrame(nudgeFrame);
      corridor.classList.add('is-explored');
    };

    track.addEventListener(
      'scroll',
      () => {
        if (track.dataset.nudging === '1' || corridor.classList.contains('is-pinned')) return;
        if (Math.abs(track.scrollLeft - rest) > 36) explore();
      },
      { passive: true },
    );
    track.addEventListener('pointerdown', () => {
      cancelAnimationFrame(nudgeFrame);
      track.style.removeProperty('scroll-snap-type');
      delete track.dataset.nudging;
    });

    const nudge = () => {
      if (nudged || explored || calm.matches || corridor.classList.contains('is-pinned')) return;
      const view = corridor.getBoundingClientRect();
      if (view.top > window.innerHeight * 0.72 || view.bottom < window.innerHeight * 0.2) return;
      nudged = true;
      const max = 78;
      const start = performance.now();
      track.style.scrollSnapType = 'none';
      const step = (now: number) => {
        if (explored || corridor.classList.contains('is-pinned')) {
          track.style.removeProperty('scroll-snap-type');
          delete track.dataset.nudging;
          return;
        }
        const t = Math.min(1, (now - start) / 1200);
        track.dataset.nudging = '1';
        track.scrollLeft = Math.sin(t * Math.PI) * max;
        if (t < 1) nudgeFrame = requestAnimationFrame(step);
        else {
          track.scrollLeft = 0;
          track.style.removeProperty('scroll-snap-type');
          window.setTimeout(() => {
            delete track.dataset.nudging;
            rest = track.scrollLeft;
          }, 450);
        }
      };
      nudgeFrame = requestAnimationFrame(step);
    };

    window.addEventListener('scroll', nudge, { passive: true });
    requestAnimationFrame(() => {
      rest = track.scrollLeft;
      nudge();
    });
  }
</script>
