---
import { loadWorks } from '@/lib/content/editorial';
import PublicLayout from '@/layouts/PublicLayout.astro';
import PhotoDrawingCompare from '@/components/art/PhotoDrawingCompare.astro';
import { t, type Locale } from '@/i18n';
import { localizedPath, workPath } from '@/i18n/routes';
import { formatEur } from '@/lib/domain/money';
import { loadPublicCatalog, topLevelProducts } from '@/lib/catalog/loadProducts';
import { getAboutImages } from '@/lib/content/siteExtras';
import { isHeroDesign, loadHeroContent, resolveHero } from '@/lib/content/homeHero';
import HeroCollage from '@/components/home/hero/HeroCollage.astro';
import HeroReveal from '@/components/home/hero/HeroReveal.astro';
import HeroWall from '@/components/home/hero/HeroWall.astro';
import HeroSketchbook from '@/components/home/hero/HeroSketchbook.astro';
import HeroSalon from '@/components/home/hero/HeroSalon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
const dict = t(locale);
const products = topLevelProducts((await loadPublicCatalog(locale)).products);
const aboutImages = await getAboutImages();
const aboutById = new Map(aboutImages.map((image) => [image.id, image.publicUrl]));
const aboutPortrait = aboutById.get('about-1') ?? aboutImages[0]?.publicUrl ?? null;
const aboutDesk = aboutById.get('about-3') ?? aboutImages[2]?.publicUrl ?? null;

const works = await loadWorks();
type Work = (typeof works)[number];

const srcOf = (w: Work, role: 'drawing' | 'reference_photo') =>
  w.data.assets.find((a) => a.role === role && a.src)?.src ?? null;

// Admin › Portada: the saved design, or another one to preview it (?portada=wall).
const heroContent = await loadHeroContent();
const previewParam = Astro.url.searchParams.get('portada');
const preview = isHeroDesign(previewParam) ? previewParam : null;
const hero = resolveHero(heroContent, works, locale, preview);
const Hero = {
  collage: HeroCollage,
  reveal: HeroReveal,
  wall: HeroWall,
  sketchbook: HeroSketchbook,
  salon: HeroSalon,
}[hero.design];
const featuredId = hero.main?.workId ?? null;

const pair =
  works.find((w) => w.id === 'sox-kira' && srcOf(w, 'drawing') && srcOf(w, 'reference_photo')) ??
  works.find((w) => w.id !== featuredId && srcOf(w, 'drawing') && srcOf(w, 'reference_photo'));

const salon = works
  .filter((w) => w.id !== featuredId && w.id !== pair?.id && srcOf(w, 'drawing'))
  .slice(0, 9);

// Names of companions Meili has already drawn, written and erased on the blank sheet.
const genericTitles = new Set(['dog', 'dogs', 'doggy', 'cat', 'perro', 'perros', 'perrito', 'gato']);
const drawnNames = [
  ...new Set(
    works
      .map((w) => w.data.title[locale].trim())
      .filter((name) => /^\p{L}{3,10}$/u.test(name) && !genericTitles.has(name.toLowerCase())),
  ),
].slice(0, 8);

const shop = [
  products.find((p) => p.category === 'mugs'),
  products.find((p) => p.category === 'greeting-cards'),
  products.find((p) => p.category === 'coasters'),
].filter((p) => p !== undefined);
---

<PublicLayout locale={locale} title={dict.nav.home} description={hero.lead} noindex={Boolean(preview)}>
  <Hero hero={hero} locale={locale} />

  <section class="corridor" aria-labelledby="corridor-title" data-corridor>
    <div class="corridor__sticky">
      <ul class="corridor__track" data-corridor-track>
        <li class="corridor__intro">
          <h2 id="corridor-title" class="display corridor__title">{dict.home.latest}</h2>
          <p class="muted">
            {es
              ? 'Cada retrato empieza con una fotografía y termina, semanas después, en papel.'
              : 'Every portrait begins with a photograph and ends, weeks later, on paper.'}
          </p>
          <a class="link" href={localizedPath(locale, 'work')}>
            {es ? 'Ver toda la obra' : 'See all the work'}
          </a>
          <p class="corridor__hint">
            <span>{es ? 'Desliza a la derecha' : 'Swipe right'}</span>
            <svg viewBox="0 0 72 16" aria-hidden="true">
              <path d="M1 8 H58"></path>
              <path d="M50 2 L62 8 L50 14"></path>
            </svg>
          </p>
        </li>
        {
          salon.map((w) => (
            <li class="corridor__item">
              <a href={workPath(locale, w.data.pathSlugs[locale])}>
                <img
                  src={srcOf(w, 'drawing')!}
                  alt={w.data.title[locale]}
                  loading="eager"
                  decoding="async"
                  style={`view-transition-name: work-${w.data.id}`}
                />
                <span class="corridor__label">{w.data.title[locale]}</span>
              </a>
            </li>
          ))
        }
        <li class="corridor__end">
          <a class="display" href={localizedPath(locale, 'work')}>
            {es ? 'Toda la obra' : 'All the work'}
          </a>
        </li>
      </ul>
    </div>
  </section>

  {
    pair && (
      <section class="section process" aria-labelledby="process-title">
        <div class="site-shell process__grid">
          <div class="process__copy">
            <h2 id="process-title" class="display h2-display">{dict.home.fromPhoto}</h2>
            <p>
              {es
                ? 'Envías tus fotografías favoritas. Meili estudia la luz, el pelaje y, sobre todo, la mirada, y lo dibuja a mano, trazo a trazo, en grafito.'
                : 'You send your favourite photographs. Meili studies the light, the coat and above all the gaze, then draws it by hand, stroke by stroke, in graphite.'}
            </p>
            <ul class="process__prices">
              <li>{dict.commissions.priceA4}</li>
              <li>{dict.commissions.priceA3}</li>
              <li>{dict.commissions.priceExtra}</li>
            </ul>
            <a class="btn" href={localizedPath(locale, 'commissions')}>{dict.home.ctaCommission}</a>
          </div>
          <div class="process__compare">
            <PhotoDrawingCompare
              photoSrc={srcOf(pair, 'reference_photo')!}
              drawingSrc={srcOf(pair, 'drawing')!}
              photoAlt={`${pair.data.title[locale]}: ${dict.art.photo}`}
              drawingAlt={`${pair.data.title[locale]}: ${dict.art.drawing}`}
              photoLabel={dict.art.photo}
              drawingLabel={dict.art.drawing}
              hint={dict.art.compareHint}
            />
          </div>
        </div>
      </section>
    )
  }

  {
    shop.length > 0 && (
      <section class="section boutique" aria-labelledby="boutique-title">
        <div class="site-shell">
          <header class="boutique__head">
            <h2 id="boutique-title" class="display h2-display">
              {es ? 'Su arte, para tu casa' : 'Her art, for your home'}
            </h2>
            <p class="muted">{dict.shop.lead}</p>
          </header>
          <ul class="boutique__grid">
            {shop.map((p, i) => (
              <li class={i === 0 ? 'boutique__item boutique__item--feature' : 'boutique__item'}>
                <a href={localizedPath(locale, 'shop', p.slug)}>
                  {p.coverImageUrl ? (
                    <img src={p.coverImageUrl} alt={p.title} loading="lazy" decoding="async" />
                  ) : (
                    <span class="boutique__ph" aria-hidden="true" />
                  )}
                  <span class="boutique__meta">
                    <span class="display boutique__name">{p.title}</span>
                    <span class="price">{formatEur(p.priceCents, locale)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link" href={localizedPath(locale, 'shop')}>
            {es ? 'Ver la tienda' : 'Visit the shop'}
          </a>
        </div>
      </section>
    )
  }

  <section class="section artist" aria-labelledby="artist-title" data-artist>
    <div class="site-shell artist__grid">
      <div class="artist__photos">
        {
          aboutDesk && (
            <figure class="snap snap--back">
              <img src={aboutDesk} alt={es ? 'Meili en su mesa de dibujo' : 'Meili at her drawing desk'} loading="lazy" decoding="async" />
            </figure>
          )
        }
        {
          aboutPortrait && (
            <figure class="snap snap--front">
              <span class="snap__film">
                <img
                  src={aboutPortrait}
                  alt={es ? 'Meili en su puesto de un mercado' : 'Meili at her market stall'}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <figcaption>{es ? 'Meili, en el mercado' : 'Meili, at the market'}</figcaption>
            </figure>
          )
        }
      </div>

      <div class="artist__copy">
        <p class="artist__eyebrow">{es ? 'La artista' : 'The artist'}</p>
        <h2 id="artist-title" class="artist__name">
          <span class="visually-hidden">Meili Stringfellow</span>
          <svg class="signature" viewBox="0 0 1000 300" aria-hidden="true" focusable="false">
            <text x="6" y="118">Meili</text>
            <text x="120" y="262">Stringfellow</text>
          </svg>
        </h2>
        <p>
          {es
            ? 'Desde su estudio en España, Meili dibuja retratos de mascotas a partir de fotografías, y también personas e ilustraciones para negocios y publicaciones.'
            : 'From her studio in Spain, Meili draws pet portraits from photographs, as well as people and illustrations for businesses and publications.'}
        </p>
        <a class="link" href={localizedPath(locale, 'about')}>
          {es ? 'Conoce a Meili' : 'Meet Meili'}
        </a>
      </div>
    </div>
  </section>

  <section class="section invite" aria-labelledby="invite-title" data-invite>
    <div class="site-shell invite__grid">
      <h2 id="invite-title" class="display invite__title">
        {es ? '¿Dibujamos a tu compañero?' : 'Shall we draw your companion?'}
      </h2>
      <form
          class="invite__form"
          method="get"
          action={`${localizedPath(locale, 'commissions')}#form`}
          data-invite-form
          data-cta-empty={dict.home.ctaCommission}
          data-cta-named={es ? 'Encargar el retrato de {name}' : 'Commission {name}’s portrait'}
        >
          <label class="invite__label" for="pet-name">
            {es ? '¿Cómo se llama?' : 'What is their name?'}
          </label>
          <input
            id="pet-name"
            class="invite__input"
            name="pet"
            maxlength="24"
            autocomplete="off"
            spellcheck="false"
            placeholder={es ? 'Escribe su nombre' : 'Type their name'}
            data-invite-input
          />
          <div class="invite__cta">
            <button class="btn" type="submit" data-invite-cta>{dict.home.ctaCommission}</button>
            <a class="link" href={localizedPath(locale, 'contact')}>{dict.nav.contact}</a>
          </div>
        </form>

      <figure class="sheet" aria-hidden="true">
        <svg class="sheet__sketch" viewBox="0 0 300 330" focusable="false">
          <g class="sketch sketch--guide">
            <path pathLength="1" style="--d:0" d="M150 52 C 108 52, 72 86, 72 132 C 72 176, 106 210, 150 210 C 194 210, 228 176, 228 132 C 228 88, 194 52, 150 52" />
            <path pathLength="1" style="--d:1" d="M148 56 C 106 58, 76 92, 76 134 C 78 174, 110 206, 152 206 C 192 204, 224 172, 224 130 C 222 90, 190 58, 148 56" />
            <path pathLength="1" style="--d:2" d="M150 30 C 151 120, 149 220, 150 318" />
            <path pathLength="1" style="--d:3" d="M66 138 C 118 133, 182 133, 234 138" />
            <path pathLength="1" style="--d:4" d="M150 176 C 120 176, 98 194, 98 218 C 98 244, 122 262, 150 262 C 178 262, 202 244, 202 218 C 202 194, 180 176, 150 176" />
          </g>
          <g class="sketch sketch--form">
            <path pathLength="1" style="--d:5" d="M96 88 C 66 94, 46 146, 54 206 C 70 204, 86 182, 98 150" />
            <path pathLength="1" style="--d:6" d="M204 88 C 234 94, 254 146, 246 206 C 230 204, 214 182, 202 150" />
            <path pathLength="1" style="--d:7" d="M122 128 C 112 128, 108 136, 110 142 C 114 150, 128 148, 130 140 C 131 134, 128 129, 122 128" />
            <path pathLength="1" style="--d:7.4" d="M178 128 C 168 129, 169 134, 170 140 C 172 148, 186 150, 190 142 C 192 136, 188 128, 178 128" />
            <path pathLength="1" style="--d:8" d="M136 200 C 144 194, 156 194, 164 200 C 162 210, 156 216, 150 217 C 144 216, 138 210, 136 200" />
            <path pathLength="1" style="--d:8.6" d="M150 217 C 150 226, 146 234, 136 236 M150 217 C 150 226, 154 234, 164 236" />
            <path pathLength="1" style="--d:9.2" d="M108 252 C 114 282, 122 302, 118 326 M192 252 C 186 282, 178 302, 182 326" />
          </g>
          <g class="sketch sketch--shade">
            <path pathLength="1" style="--d:10" d="M176 150 l 14 -18 M182 154 l 14 -18 M188 158 l 14 -18 M194 162 l 14 -18 M200 166 l 14 -18 M206 170 l 14 -18 M212 174 l 14 -18 M218 178 l 14 -18 M224 182 l 14 -18 M88 168 l 10 -14 M93 173 l 10 -14 M98 178 l 10 -14 M103 183 l 10 -14 M108 188 l 10 -14 M113 193 l 10 -14" />
            <path pathLength="1" style="--d:11" d="M60 150 c 3 12, 2 24, 6 36 M66 120 c -2 10, -3 22, -2 32 M240 150 c -3 12, -2 24, -6 36 M234 120 c 2 10, 3 22, 2 32 M120 70 c 6 -6, 14 -9, 22 -9 M160 62 c 8 0, 16 3, 22 8 M140 186 c 2 4, 4 6, 8 7 M160 186 c -2 4, -4 6, -8 7" />
          </g>
        </svg>
        <p class="sheet__name" data-sheet-name data-names={JSON.stringify(drawnNames)}></p>
        <p class="sheet__note">{es ? 'su retrato' : 'their portrait'}</p>
      </figure>
    </div>
  </section>
</PublicLayout>

<style>
  .link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.35em;
    transition: text-decoration-color var(--dur-ui) var(--ease-soft);
  }

  .link:hover {
    text-decoration-color: var(--ink);
  }


  .boutique__head {
    max-width: 38rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }


  /* ——— Corridor: drawings pass by as the visitor walks (scrolls) ——— */
  .corridor {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .corridor__track {
    list-style: none;
    margin: 0;
    display: flex;
    align-items: flex-end;
    gap: clamp(1.25rem, 3vw, 3.5rem);
    padding: 1rem max(1.25rem, calc((100vw - var(--max-editorial)) / 2)) 2.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .corridor__track::-webkit-scrollbar {
    display: none;
  }

  .corridor__intro {
    flex: 0 0 min(80vw, 24rem);
    align-self: center;
    display: grid;
    gap: 1rem;
    justify-items: start;
    scroll-snap-align: start;
  }

  .corridor__title {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.6rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .corridor__intro p {
    margin: 0;
    font-size: 1.08rem;
    max-width: 22rem;
  }

  .corridor__item {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  .corridor__item:nth-child(even) {
    margin-bottom: 3.5rem;
  }

  .corridor__item a {
    display: grid;
    gap: 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .corridor__item img {
    height: min(58svh, 30rem);
    width: auto;
    max-width: 82vw;
    object-fit: contain;
    padding: clamp(0.45rem, 1vw, 0.8rem);
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out);
  }

  .corridor__item a:hover img {
    transform: translateY(-8px);
    box-shadow:
      0 1px 2px rgb(22 23 26 / 0.06),
      0 20px 34px -12px rgb(22 23 26 / 0.16),
      0 60px 90px -36px rgb(22 23 26 / 0.28);
  }

  .corridor__label {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
  }

  .corridor__end {
    flex: 0 0 auto;
    align-self: center;
    padding-inline: 2rem 1rem;
  }

  .corridor__end a {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-style: italic;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .corridor__sticky {
    position: relative;
  }

  /* On touch (and reduced motion) the walk is a sideways swipe, so say so */
  .corridor__hint {
    display: none;
    margin: 0.15rem 0 0;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--ink);
    transition: opacity 400ms var(--ease-out);
  }

  .corridor.needs-swipe .corridor__hint {
    display: flex;
  }

  .corridor__hint svg {
    width: 3.4rem;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: point 1.5s var(--ease-out) infinite;
  }

  .corridor.needs-swipe .corridor__sticky::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    bottom: 0;
    width: 4.5rem;
    background: linear-gradient(90deg, transparent, var(--paper) 86%);
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
  }

  .corridor.is-explored .corridor__hint,
  .corridor.is-explored .corridor__sticky::after {
    opacity: 0;
  }

  @keyframes point {
    0%,
    100% {
      transform: translateX(0);
    }
    55% {
      transform: translateX(9px);
    }
  }

  @media (max-width: 63.99rem) {
    .corridor__intro {
      flex-basis: 62vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .corridor__hint svg {
      animation: none;
    }
  }

  /* Pinned on desktop: vertical scroll drives the horizontal walk */
  .corridor.is-pinned {
    padding-block: 0;
    height: var(--corridor-h, 300vh);
  }

  .corridor.is-pinned .corridor__sticky {
    position: sticky;
    top: var(--header-h, 5.5rem);
    height: calc(100svh - var(--header-h, 5.5rem));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .corridor.is-pinned .corridor__track {
    overflow: visible;
    scroll-snap-type: none;
    transform: translate3d(var(--corridor-x, 0px), 0, 0);
    will-change: transform;
  }

  /* ——— Process ——— */
  .process {
    background: var(--paper-deep);
  }

  .process__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .process__copy p {
    max-width: 34rem;
    font-size: 1.12rem;
    color: var(--ink-soft);
  }

  .process__prices {
    list-style: none;
    margin: 1.75rem 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .process__compare :global(.compare__stage) {
    aspect-ratio: 3 / 2;
  }

  .process__compare :global(.compare__base),
  .process__compare :global(.compare__overlay) {
    object-fit: cover;
  }

  @media (min-width: 64rem) {
    .process__grid {
      grid-template-columns: 5fr 7fr;
    }
  }

  /* ——— Boutique ——— */
  .boutique__grid {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .boutique__item a {
    display: grid;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .boutique__item img,
  .boutique__ph {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .boutique__ph {
    display: block;
    background: var(--paper-deep);
  }

  .boutique__item a:hover img {
    transform: scale(1.015);
  }

  .boutique__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .boutique__name {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  @media (min-width: 48rem) {
    .boutique__grid {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: auto auto;
    }

    .boutique__item--feature {
      grid-row: 1 / 3;
    }

    .boutique__item--feature img {
      aspect-ratio: 4 / 5;
    }

    .boutique__item:not(.boutique__item--feature) img {
      aspect-ratio: 4 / 3;
    }
  }

  /* ——— Artist: an instant photo that develops, a name written in ink ——— */
  .artist__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .artist__photos {
    position: relative;
    width: min(100%, 30rem);
    justify-self: center;
    aspect-ratio: 5 / 6;
  }

  .snap {
    position: absolute;
    margin: 0;
    padding: 0.7rem 0.7rem 3.2rem;
    background: var(--sheet);
    box-shadow: var(--shadow-art);
  }

  .snap::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: -0.7rem;
    left: 50%;
    width: 38%;
    height: 1.4rem;
    translate: -50% 0;
    rotate: -3deg;
    background: rgb(214 220 232 / 0.8);
    box-shadow: 0 1px 2px rgb(22 23 26 / 0.08);
  }

  .snap img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    box-shadow: none;
    border-radius: 0;
  }

  .snap--back {
    top: 0;
    right: 0;
    width: 58%;
    rotate: 7deg;
    transition: rotate 700ms var(--ease-out), translate 700ms var(--ease-out);
  }

  .snap--back img {
    object-position: 30% 30%;
  }

  .snap--front {
    z-index: 2;
    left: 0;
    bottom: 0;
    width: 76%;
    rotate: -4deg;
    transition: rotate 700ms var(--ease-out);
  }

  .artist__photos:hover .snap--back {
    rotate: 11deg;
    translate: 1.5rem -0.75rem;
  }

  .artist__photos:hover .snap--front {
    rotate: -6deg;
  }

  .snap__film {
    position: relative;
    display: block;
    overflow: hidden;
    background: #23241f;
  }

  .snap--front figcaption {
    position: absolute;
    inset: auto 0 0.85rem;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: var(--ink-soft);
  }

  /* before it develops: a dark, flat, warm sheet of film */
  .artist.is-armed .snap__film img {
    filter: brightness(0.18) sepia(0.9) saturate(0.4) contrast(0.6) blur(3px);
  }

  .artist.is-armed .snap__film::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 40% 45%, rgb(74 70 52 / 0.0), rgb(40 38 30 / 0.65));
    opacity: 1;
    pointer-events: none;
  }

  .artist.is-armed .snap--front figcaption {
    clip-path: inset(0 100% 0 0);
  }

  .artist.is-developed .snap__film img {
    animation: develop 4.2s cubic-bezier(0.3, 0.05, 0.25, 1) forwards;
  }

  .artist.is-developed .snap__film::after {
    animation: fade-out 4.2s ease-out forwards;
  }

  .artist.is-developed .snap--front figcaption {
    animation: write 1.6s steps(24, end) 2.8s forwards;
  }

  .artist__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .artist__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .artist__name {
    margin: 0;
    width: min(100%, 38rem);
  }

  .signature {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .signature text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 150px;
    letter-spacing: -0.04em;
    fill: var(--ink);
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .signature text + text {
    fill: var(--accent-deep);
    stroke: var(--accent-deep);
  }

  .artist.is-armed .signature text {
    fill-opacity: 0;
    stroke-dasharray: 1100;
    stroke-dashoffset: 1100;
  }

  .artist.is-developed .signature text {
    animation:
      trace 2.4s cubic-bezier(0.45, 0.05, 0.3, 1) 0.4s forwards,
      ink-fill 1.2s ease-out 2.2s forwards;
  }

  .artist.is-developed .signature text + text {
    animation-delay: 1.1s, 2.9s;
  }

  .artist__copy p {
    margin: 0;
    max-width: 32rem;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  @keyframes develop {
    0% {
      filter: brightness(0.18) sepia(0.9) saturate(0.4) contrast(0.6) blur(3px);
    }
    35% {
      filter: brightness(0.6) sepia(0.6) saturate(0.6) contrast(0.75) blur(1.2px);
    }
    70% {
      filter: brightness(0.95) sepia(0.2) saturate(0.9) contrast(0.95) blur(0);
    }
    100% {
      filter: none;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes write {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes trace {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes ink-fill {
    to {
      fill-opacity: 1;
      stroke-width: 0;
    }
  }

  @media (min-width: 64rem) {
    .artist__grid {
      grid-template-columns: 5fr 6fr;
    }
  }

  /* ——— Invite: a blank sheet, the first construction lines, their name ——— */
  .invite {
    border-top: 1px solid var(--line);
    overflow: clip;
  }

  /* Phones: title, sheet, then the field, so the name is seen as it is typed. */
  .invite__grid {
    display: grid;
    grid-template-areas: 'title' 'sheet' 'form';
    column-gap: clamp(3rem, 6vw, 5rem);
    row-gap: 2.5rem;
    align-items: center;
  }

  .invite__title {
    grid-area: title;
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2.8rem, 6.5vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .invite__form {
    grid-area: form;
    display: grid;
    gap: 0.4rem;
    max-width: 28rem;
  }

  .invite__label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .invite__input {
    width: 100%;
    padding: 0.3rem 0 0.45rem;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    transition: border-color var(--dur-ui) var(--ease-soft);
  }

  .invite__input::placeholder {
    color: var(--muted);
    opacity: 0.55;
  }

  .invite__input:focus-visible {
    outline: none;
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 0 var(--accent);
  }

  .invite__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }

  .sheet {
    grid-area: sheet;
    position: relative;
    justify-self: center;
    width: min(100%, 26rem);
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2vw, 1.5rem);
    background:
      radial-gradient(ellipse at 30% 20%, #fff, transparent 70%),
      var(--sheet);
    box-shadow: var(--shadow-art);
    rotate: 2deg;
  }

  .sheet::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: -0.75rem;
    left: 50%;
    width: 34%;
    height: 1.45rem;
    translate: -50% 0;
    rotate: -2.5deg;
    background: rgb(214 220 232 / 0.8);
    box-shadow: 0 1px 2px rgb(22 23 26 / 0.08);
  }

  .sheet__sketch {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sketch path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sketch--guide path {
    stroke: var(--ink-soft);
    stroke-opacity: 0.32;
    stroke-width: 0.9;
  }

  .sketch--form path {
    stroke: var(--ink);
    stroke-opacity: 0.72;
    stroke-width: 1.4;
  }

  .sketch--shade path {
    stroke: var(--ink-soft);
    stroke-opacity: 0.45;
    stroke-width: 0.8;
  }

  .invite.is-drawing .sketch--shade path {
    animation-duration: 2.2s;
  }

  .invite.is-armed .sketch path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .invite.is-drawing .sketch path {
    animation: trace 1.1s cubic-bezier(0.45, 0.05, 0.3, 1) forwards;
    animation-delay: calc(0.2s + var(--d) * 0.32s);
  }

  .sheet__name {
    min-height: 1.2em;
    margin: 0.2rem 0 0;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .sheet__name.is-ghost {
    color: var(--muted);
    opacity: 0.6;
  }

  .sheet__name span {
    display: inline-block;
    animation: letter-in 380ms var(--ease-out) both;
  }

  .sheet__note {
    margin: 0;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @keyframes letter-in {
    from {
      opacity: 0;
      filter: blur(3px);
      transform: translateY(0.15em) rotate(-4deg);
    }
  }

  @media (max-width: 63.99rem) {
    .sheet {
      width: min(82%, 22rem);
    }
  }

  @media (min-width: 64rem) {
    .invite__grid {
      grid-template-columns: 6fr 5fr;
      grid-template-areas: 'title sheet' 'form sheet';
      row-gap: 2.5rem;
    }

    .invite__title {
      align-self: end;
    }

    .invite__form {
      align-self: start;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

</style>

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 64rem) and (hover: hover) and (pointer: fine)');

  const corridor = document.querySelector<HTMLElement>('[data-corridor]');
  const track = document.querySelector<HTMLElement>('[data-corridor-track]');
  if (corridor && track) {
    let distance = 0;
    let frame = 0;

    const header = document.querySelector<HTMLElement>('[data-site-header]');

    const layout = () => {
      const pin = desktop.matches && !calm.matches;
      corridor.classList.toggle('is-pinned', pin);
      corridor.classList.toggle('needs-swipe', !pin);
      if (!pin) {
        corridor.style.removeProperty('--corridor-h');
        track.style.removeProperty('--corridor-x');
        return;
      }
      const headerH = header?.offsetHeight ?? 0;
      corridor.style.setProperty('--header-h', `${headerH}px`);
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      corridor.style.setProperty('--corridor-h', `${window.innerHeight - headerH + distance}px`);
      update();
    };

    const update = () => {
      frame = 0;
      if (!corridor.classList.contains('is-pinned')) return;
      const headerH = header?.offsetHeight ?? 0;
      const start = corridor.getBoundingClientRect().top + window.scrollY - headerH;
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, distance)));
      track.style.setProperty('--corridor-x', `${-progress * distance}px`);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', layout);
    desktop.addEventListener('change', layout);
    calm.addEventListener('change', layout);
    track.querySelectorAll('img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', layout, { once: true });
    });
    layout();

    /* Teach the sideways swipe: a hint, and one small nudge when it comes into view */
    let explored = false;
    let nudged = false;
    let nudgeFrame = 0;
    let rest = 0;

    const explore = () => {
      if (explored) return;
      explored = true;
      cancelAnimationFrame(nudgeFrame);
      corridor.classList.add('is-explored');
    };

    track.addEventListener(
      'scroll',
      () => {
        if (track.dataset.nudging === '1' || corridor.classList.contains('is-pinned')) return;
        if (Math.abs(track.scrollLeft - rest) > 36) explore();
      },
      { passive: true },
    );
    track.addEventListener('pointerdown', () => {
      cancelAnimationFrame(nudgeFrame);
      track.style.removeProperty('scroll-snap-type');
      delete track.dataset.nudging;
    });

    const nudge = () => {
      if (nudged || explored || calm.matches || corridor.classList.contains('is-pinned')) return;
      const view = corridor.getBoundingClientRect();
      if (view.top > window.innerHeight * 0.72 || view.bottom < window.innerHeight * 0.2) return;
      nudged = true;
      const max = 78;
      const start = performance.now();
      track.style.scrollSnapType = 'none';
      const step = (now: number) => {
        if (explored || corridor.classList.contains('is-pinned')) {
          track.style.removeProperty('scroll-snap-type');
          delete track.dataset.nudging;
          return;
        }
        const t = Math.min(1, (now - start) / 1200);
        track.dataset.nudging = '1';
        track.scrollLeft = Math.sin(t * Math.PI) * max;
        if (t < 1) nudgeFrame = requestAnimationFrame(step);
        else {
          track.scrollLeft = 0;
          track.style.removeProperty('scroll-snap-type');
          window.setTimeout(() => {
            delete track.dataset.nudging;
            rest = track.scrollLeft;
          }, 450);
        }
      };
      nudgeFrame = requestAnimationFrame(step);
    };

    window.addEventListener('scroll', nudge, { passive: true });
    requestAnimationFrame(() => {
      rest = track.scrollLeft;
      nudge();
    });
  }

  /* ——— Artist: the photo develops and the name is written when they come into view ——— */
  const watchOnce = (el: Element, onSeen: () => void, threshold = 0.35) => {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        io.disconnect();
        onSeen();
      },
      { threshold },
    );
    io.observe(el);
  };

  const artist = document.querySelector<HTMLElement>('[data-artist]');
  if (artist && !calm.matches) {
    artist.classList.add('is-armed');
    watchOnce(artist, () => artist.classList.add('is-developed'));
  }

  /* ——— Invite: construction lines, then their name on the sheet ——— */
  const invite = document.querySelector<HTMLElement>('[data-invite]');
  const inviteForm = invite?.querySelector<HTMLFormElement>('[data-invite-form]');
  const petInput = invite?.querySelector<HTMLInputElement>('[data-invite-input]');
  const inviteCta = invite?.querySelector<HTMLButtonElement>('[data-invite-cta]');
  const sheetName = invite?.querySelector<HTMLElement>('[data-sheet-name]');

  if (invite && inviteForm && petInput && inviteCta && sheetName) {
    const names: string[] = JSON.parse(sheetName.dataset.names || '[]');
    let ghostTimer = 0;
    let visible = false;

    const write = (text: string, ghost: boolean, animateFrom = 0) => {
      sheetName.classList.toggle('is-ghost', ghost);
      sheetName.replaceChildren(
        ...[...text].map((char, i) => {
          const span = document.createElement('span');
          span.textContent = char === ' ' ? '\u00a0' : char;
          if (i < animateFrom) span.style.animation = 'none';
          return span;
        }),
      );
    };

    const ctaFor = (name: string) =>
      name
        ? (inviteForm.dataset.ctaNamed ?? '').replace('{name}', name)
        : (inviteForm.dataset.ctaEmpty ?? '');

    // Write and erase the names of companions already drawn, while the field is empty.
    let nameIndex = 0;
    const ghostCycle = () => {
      window.clearTimeout(ghostTimer);
      if (!visible || petInput.value || document.activeElement === petInput || !names.length) return;
      const name = names[nameIndex % names.length];
      nameIndex += 1;
      let shown = 0;
      const typeNext = () => {
        if (petInput.value || document.activeElement === petInput) return;
        shown += 1;
        write(name.slice(0, shown), true, shown - 1);
        if (shown < name.length) ghostTimer = window.setTimeout(typeNext, 110);
        else ghostTimer = window.setTimeout(eraseNext, 1700);
      };
      const eraseNext = () => {
        if (petInput.value || document.activeElement === petInput) return;
        shown -= 1;
        write(name.slice(0, shown), true, shown + 1);
        if (shown > 0) ghostTimer = window.setTimeout(eraseNext, 45);
        else ghostTimer = window.setTimeout(ghostCycle, 450);
      };
      typeNext();
    };

    let previous = '';
    petInput.addEventListener('input', () => {
      window.clearTimeout(ghostTimer);
      const name = petInput.value.trim();
      const common = [...name].findIndex((char, i) => previous[i] !== char);
      write(name, false, common === -1 ? name.length : common);
      previous = name;
      inviteCta.textContent = ctaFor(name);
    });
    petInput.addEventListener('focus', () => {
      window.clearTimeout(ghostTimer);
      if (!petInput.value) write('', false);
    });
    petInput.addEventListener('blur', () => {
      if (!petInput.value) ghostTimer = window.setTimeout(ghostCycle, 900);
    });

    if (calm.matches) {
      if (names[0]) write(names[0], true, names[0].length);
    } else {
      invite.classList.add('is-armed');
      watchOnce(invite, () => invite.classList.add('is-drawing'), 0.3);
      new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (visible) ghostTimer = window.setTimeout(ghostCycle, 3400);
        else window.clearTimeout(ghostTimer);
      }, { threshold: 0.2 }).observe(invite);
    }
  }
</script>
