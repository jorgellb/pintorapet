  .reference strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    letter-spacing: 0.02em;
  }

  .request__aside {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .request__aside-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .direct {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .direct li {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--line-strong);
  }

  .direct span {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .direct a {
    font-family: var(--font-display);
