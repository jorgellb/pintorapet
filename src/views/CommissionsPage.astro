    }

    .request__aside {
      position: sticky;
      top: 2rem;
      padding-top: 2rem;
    }
  }
</style>

<script>
  import { enhanceForm } from '@/scripts/enhanceForm';

  document.querySelectorAll<HTMLFormElement>('form[data-enhance]').forEach(enhanceForm);

  const form = document.querySelector<HTMLFormElement>('[data-commission-form]');
  const output = form?.querySelector<HTMLOutputElement>('[data-estimate]');
  const subjects = form?.querySelector<HTMLInputElement>('input[name="subjects"]');

  if (form && output && subjects) {
    const { a4, a3, extra, max, open } = output.dataset;
    const money = new Intl.NumberFormat(form.dataset.locale === 'es' ? 'es-ES' : 'en-GB', {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits: 0,
    });
    const limit = Number(max) || 10;
    const less = form.querySelector<HTMLButtonElement>('[data-step="-1"]');
    const more = form.querySelector<HTMLButtonElement>('[data-step="1"]');

    const count = () => Math.min(limit, Math.max(1, Math.trunc(Number(subjects.value)) || 1));

    const update = () => {
      const size = form.querySelector<HTMLInputElement>('input[name="size"]:checked')?.value;
      const base = size === 'A4' ? Number(a4) : size === 'A3' ? Number(a3) : null;
      output.textContent =
        base === null ? (open ?? '') : money.format((base + (count() - 1) * Number(extra)) / 100);
      if (less) less.disabled = count() <= 1;
      if (more) more.disabled = count() >= limit;
    };

    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => {
        subjects.value = String(Math.min(limit, Math.max(1, count() + Number(button.dataset.step))));
        update();
      });
    });
    subjects.addEventListener('change', () => {
      subjects.value = String(count());
      update();
    });
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    update();
  }
</script>
