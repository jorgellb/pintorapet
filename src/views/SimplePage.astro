---
import PublicLayout from '@/layouts/PublicLayout.astro';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
}

const { locale, title, description, noindex } = Astro.props;
---

<PublicLayout locale={locale} title={title} description={description} noindex={noindex}>
  <section class="section">
    <div class="site-shell prose">
      <h1 class="display h1-display">{title}</h1>
      <slot />
    </div>
  </section>
</PublicLayout>

<style>
  .prose {
    max-width: 42rem;
  }

  .prose :global(p) {
    color: var(--muted);
  }

  .prose :global(ul) {
    color: var(--muted);
  }
</style>
