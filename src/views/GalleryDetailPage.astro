---
import { loadGallery } from '@/lib/content/editorial';
import PublicLayout from '@/layouts/PublicLayout.astro';
import PhotoDrawingCompare from '@/components/art/PhotoDrawingCompare.astro';
import ImageLightbox from '@/components/art/ImageLightbox.astro';
import { t, type Locale } from '@/i18n';
import { localizedPath } from '@/i18n/routes';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const es = locale === 'es';
const dict = t(locale);
const items = await loadGallery();
const index = items.findIndex((item) => item.data.id === slug);
const entry = items[index];
if (!entry) {
  return Astro.redirect(localizedPath(locale, 'gallery'));
}

const title = entry.data.title[locale];
const assets = entry.data.assets.filter((asset) => Boolean(asset.src));
const drawing = assets.find((asset) => asset.role === 'drawing') ?? assets[0];
const photo = assets.find((asset) => asset.role === 'reference_photo');
const canCompare = Boolean(drawing?.src && photo?.src && drawing !== photo);
const extras = assets.filter((asset) => asset !== drawing && (!canCompare || asset !== photo));
const description = entry.data.summary?.[locale]?.trim() ?? '';
const process = entry.data.story?.[locale]?.trim() ?? '';
const groups: Record<string, { en: string; es: string }> = {
  people: { en: 'People', es: 'Personas' },
  architecture: { en: 'Architecture', es: 'Arquitectura' },
  illustration: { en: 'Illustration', es: 'Ilustración' },
  other: { en: 'Other', es: 'Otros' },
};
---

<PublicLayout locale={locale} title={title} description={description || title}>
  <article>
    <section class="piece">
      <div class="site-shell piece__grid">
        <header class="piece__head">
          <a class="piece__back" href={localizedPath(locale, 'gallery')}>{dict.nav.gallery}</a>
          <h1 class="display piece__title">{title}</h1>
          <p class="plaque">
            <span>{groups[entry.data.group]?.[locale] ?? entry.data.group}</span>
            <span>Meili Stringfellow</span>
          </p>
        </header>
        {
          drawing?.src && (
            <figure class="piece__wall">
              <button
                type="button"
                class="piece__zoom"
                data-lightbox-src={drawing.src}
                data-lightbox-alt={drawing.alt?.[locale] ?? title}
              >
                <img
                  src={drawing.src}
                  alt={drawing.alt?.[locale] ?? title}
                  loading="eager"
                  decoding="async"
                />
                <span class="visually-hidden">
                  {dict.art.openLightbox}: {title}
                </span>
              </button>
            </figure>
          )
        }
      </div>
    </section>

    {
      (description || process) && (
        <section class="notes">
          <div class="site-shell notes__grid">
            {
              description && (
                <div>
                  <h2 class="display notes__title">{es ? 'Descripción' : 'Description'}</h2>
                  <p class="notes__text">{description}</p>
                </div>
              )
            }
            {
              process && (
                <div>
                  <h2 class="display notes__title">{es ? 'Proceso de trabajo' : 'Working process'}</h2>
                  <p class="notes__text">{process}</p>
                </div>
              )
            }
          </div>
        </section>
      )
    }

    {
      canCompare && drawing?.src && photo?.src && (
        <section class="compare-band">
          <div class="site-shell compare-band__grid">
            <div>
              <h2 class="display notes__title">{dict.home.fromPhoto}</h2>
              <p class="muted">{dict.art.compareHint}</p>
            </div>
            <PhotoDrawingCompare
              compact
              photoSrc={photo.src}
              drawingSrc={drawing.src}
              photoAlt={photo.alt?.[locale] ?? title}
              drawingAlt={drawing.alt?.[locale] ?? title}
              photoLabel={dict.art.photo}
              drawingLabel={dict.art.drawing}
              hint={dict.art.compareHint}
            />
          </div>
        </section>
      )
    }

    {
      extras.length > 0 && (
        <ul class="site-shell extras">
          {extras.map((asset) => (
            <li>
              <button
                type="button"
                class="thumb"
                data-lightbox-src={asset.src}
                data-lightbox-alt={asset.alt?.[locale] ?? title}
              >
                <img src={asset.src} alt={asset.alt?.[locale] ?? title} loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ul>
      )
    }
  </article>
  <ImageLightbox closeLabel={dict.art.closeLightbox} />
</PublicLayout>

<style>
  .piece {
    padding-block: 0.5rem clamp(2.5rem, 6vw, 4.5rem);
  }

  .piece__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .piece__head {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .piece__back {
    color: var(--muted);
    text-decoration: none;
  }

  .piece__back::before {
    content: '← ';
  }

  .piece__title {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .plaque {
    margin: 0;
    display: grid;
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-strong);
    color: var(--muted);
  }

  .piece__wall {
    margin: 0;
  }

  .piece__zoom,
  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .piece__zoom img {
    width: 100%;
    max-height: 62svh;
    object-fit: contain;
    padding: clamp(0.45rem, 1vw, 0.8rem);
  }

  .notes,
  .compare-band {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .compare-band {
    background: var(--paper-deep);
  }

  .notes__grid,
  .compare-band__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    justify-items: start;
  }

  .notes__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .notes__text {
    margin: 0;
    max-width: 38rem;
    font-size: 1.05rem;
    line-height: 1.65;
    white-space: pre-line;
  }

  .extras {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem;
    padding-block: 1rem 3rem;
  }

  .extras img {
    width: 100%;
    padding: 0.4rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (min-width: 64rem) {
    .piece__grid {
      grid-template-columns: 4fr 7fr;
    }

    .notes__grid,
    .compare-band__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
