---
import PublicLayout from '@/layouts/PublicLayout.astro';
import type { Locale } from '@/i18n';
import { localizedPath } from '@/i18n/routes';
import { loadPublicCatalog } from '@/lib/catalog/loadProducts';
import { formatEur } from '@/lib/domain/money';
import { customerStatus } from '@/lib/domain/orderStatus';
import { listOrders, loadProfile } from '@/lib/server/account';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';
// The middleware only lets signed-in visitors reach this page.
const session = Astro.locals.customer!;

const [profile, orders, catalog] = await Promise.all([
  loadProfile(session),
  listOrders(session),
  loadPublicCatalog(locale),
]);
const images = new Map(catalog.products.map((p) => [p.id, p.coverImageUrl]));
const names = new Intl.DisplayNames([locale], { type: 'region' });
const date = new Intl.DateTimeFormat(es ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const firstName = profile.full_name.split(/\s+/)[0] || '';
const flash = Astro.url.searchParams.get('password') === '1' ? 'password' : Astro.url.searchParams.get('saved') === '1' ? 'saved' : null;

const copy = es
  ? {
      eyebrow: 'Tu cuenta',
      hello: firstName ? `Hola, ${firstName}` : 'Hola',
      italic: 'este es tu rincón',
      lead: 'Tus pedidos, tus facturas y tus datos, en un solo sitio.',
      flash: { password: 'Contraseña cambiada. Ya puedes usarla.', saved: 'Datos guardados.' },
      orders: 'Tus pedidos',
      emptyTitle: 'Aún no hay pedidos',
      emptyLead: `Los pedidos que hagas con ${session.user.email} aparecerán aquí, también los que hiciste sin cuenta.`,
      shop: 'Ir a la tienda',
      more: (n: number) => (n === 1 ? 'y 1 pieza más' : `y ${n} piezas más`),
      profile: 'Tu ficha',
      email: 'Email',
      phone: 'Teléfono',
      address: 'Dirección de envío',
      billing: 'Datos de factura',
      none: 'Sin añadir',
      edit: 'Editar mis datos',
      signOut: 'Cerrar sesión',
      steps: ['Pagado', 'Preparando', 'En camino', 'Entregado'],
    }
  : {
      eyebrow: 'Your account',
      hello: firstName ? `Hello, ${firstName}` : 'Hello',
      italic: 'this is your corner',
      lead: 'Your orders, your invoices and your details, all in one place.',
      flash: { password: 'Password changed. You can use it now.', saved: 'Details saved.' },
      orders: 'Your orders',
      emptyTitle: 'No orders yet',
      emptyLead: `Orders placed with ${session.user.email} will appear here, including those placed without an account.`,
      shop: 'Visit the shop',
      more: (n: number) => (n === 1 ? 'and 1 more piece' : `and ${n} more pieces`),
      profile: 'Your details',
      email: 'Email',
      phone: 'Phone',
      address: 'Delivery address',
      billing: 'Invoice details',
      none: 'Not added',
      edit: 'Edit my details',
      signOut: 'Sign out',
      steps: ['Paid', 'Preparing', 'On its way', 'Delivered'],
    };

const address = profile.address;
---

<PublicLayout locale={locale} title={copy.eyebrow} noindex>
  <section class="section account">
    <div class="site-shell account__grid">
      <header class="account__head">
        <p class="page-eyebrow">{copy.eyebrow}</p>
        <h1 class="display account__title">
          {copy.hello} <em>{copy.italic}</em>
        </h1>
        <p class="account__lead">{copy.lead}</p>
        {flash && <p class="account__flash" role="status">{copy.flash[flash]}</p>}
      </header>

      <section class="orders" aria-labelledby="orders-title">
        <h2 id="orders-title" class="account__h2">
          {copy.orders} {orders.length > 0 && <small>{orders.length}</small>}
        </h2>
        {
          orders.length === 0 ? (
            <div class="orders__empty">
              <p class="display">{copy.emptyTitle}</p>
              <p>{copy.emptyLead}</p>
              <a class="btn" href={localizedPath(locale, 'shop')}>{copy.shop}</a>
            </div>
          ) : (
            <ul class="orders__list">
              {orders.map((order, i) => {
                const status = customerStatus(order.payment_status, order.fulfillment_status, locale);
                const thumbs = order.items
                  .map((item) => (item.product_id ? images.get(item.product_id) : null))
                  .filter((src): src is string => Boolean(src))
                  .slice(0, 3);
                const [first, ...rest] = order.items;
                const restCount = rest.reduce((n, item) => n + item.quantity, 0) + (first ? first.quantity - 1 : 0);
                return (
                  <li style={`--i:${i}`}>
                    <a class="order" href={localizedPath(locale, 'accountOrder', order.reference)}>
                      <span class="order__thumbs" aria-hidden="true">
                        {thumbs.length > 0
                          ? thumbs.map((src, n) => <span class="order__thumb" style={`background-image:url('${src}');--n:${n}`} />)
                          : <span class="order__thumb order__thumb--empty" />}
                      </span>
                      <span class="order__main">
                        <span class="order__ref">{order.reference}</span>
                        <span class="order__items">
                          {first?.title}
                          {restCount > 0 && <> {copy.more(restCount)}</>}
                        </span>
                        <span class="order__date">{date.format(new Date(order.paid_at ?? order.created_at))}</span>
                      </span>
                      <span class="order__side">
                        <span class="order__total price">{formatEur(order.total_cents, locale)}</span>
                        <span class={`chip-status chip-status--${status.key}`}>{status.label}</span>
                        {status.key !== 'refunded' && status.key !== 'review' && (
                          <span class="order__track" aria-hidden="true">
                            {copy.steps.map((_, s) => (
                              <span class:list={['order__dot', { 'is-on': s <= status.step && status.key !== 'processing' }]} />
                            ))}
                          </span>
                        )}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>

      <aside class="card" aria-labelledby="profile-title">
        <h2 id="profile-title" class="account__h2">{copy.profile}</h2>
        <dl class="card__list">
          <div>
            <dt>{copy.email}</dt>
            <dd>{session.user.email}</dd>
          </div>
          <div>
            <dt>{copy.phone}</dt>
            <dd>{profile.phone || <span class="muted">{copy.none}</span>}</dd>
          </div>
          <div>
            <dt>{copy.address}</dt>
            <dd>
              {
                address ? (
                  <address>
                    {profile.full_name}<br />
                    {address.line1}{address.line2 && `, ${address.line2}`}<br />
                    {address.postal_code} {address.city}
                    {address.state && `, ${address.state}`}<br />
                    {names.of(address.country) ?? address.country}
                  </address>
                ) : (
                  <span class="muted">{copy.none}</span>
                )
              }
            </dd>
          </div>
          <div>
            <dt>{copy.billing}</dt>
            <dd>
              {
                profile.billing ? (
                  <>
                    {profile.billing.name}<br />
                    <span class="mono">{profile.billing.taxId}</span>
                  </>
                ) : (
                  <span class="muted">{copy.none}</span>
                )
              }
            </dd>
          </div>
        </dl>
        <a class="btn btn--ghost" href={localizedPath(locale, 'accountDetails')}>{copy.edit}</a>
        <form method="post" action="/api/auth/logout/" class="card__out">
          <input type="hidden" name="locale" value={locale} />
          <button type="submit" class="text-button">{copy.signOut}</button>
        </form>
      </aside>
    </div>
  </section>
</PublicLayout>

<style>
  .account__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    grid-template-areas: 'head' 'orders' 'card';
  }

  .account__head {
    grid-area: head;
  }

  .orders {
    grid-area: orders;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .card {
    grid-area: card;
  }

  @media (min-width: 64rem) {
    .account__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(3rem, 5vw, 5rem);
      grid-template-areas: 'head head' 'orders card';
    }

    .card {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }

  .page-eyebrow {
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .page-eyebrow::before {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: currentColor;
  }

  .account__title {
    margin: 0 0 1rem;
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .account__title em {
    display: block;
    font-style: italic;
    color: var(--accent-deep);
  }

  .account__lead {
    margin: 0;
    max-width: 32rem;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }

  .account__flash {
    display: inline-block;
    margin: 1.25rem 0 0;
    padding: 0.6rem 1rem;
    border-left: 2px solid var(--success);
    background: rgb(47 107 82 / 0.08);
    color: var(--success);
  }

  .account__h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
  }

  .account__h2 small {
    margin-left: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* ——— Orders ——— */
  .orders__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .orders__list li {
    animation: rise 600ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 70ms);
  }

  .order {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.1rem 1.25rem;
    background: var(--sheet);
    box-shadow: var(--shadow-art);
    color: var(--ink);
    text-decoration: none;
    transition: transform 400ms var(--ease-out), box-shadow 400ms var(--ease-out);
  }

  .order:hover {
    color: var(--ink);
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgb(22 23 26 / 0.06),
      0 20px 34px -12px rgb(22 23 26 / 0.18);
  }

  .order__thumbs {
    position: relative;
    width: 4.6rem;
    height: 4.2rem;
  }

  .order__thumb {
    position: absolute;
    top: calc(var(--n, 0) * 0.25rem);
    left: calc(var(--n, 0) * 0.55rem);
    width: 3.4rem;
    aspect-ratio: 1;
    border: 0.2rem solid #fff;
    background: var(--paper-deep) center / cover no-repeat;
    box-shadow: 0 2px 6px rgb(22 23 26 / 0.2);
    rotate: calc(-4deg + var(--n, 0) * 5deg);
    z-index: calc(3 - var(--n, 0));
  }

  .order__main {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .order__ref {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .order__items {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .order__date {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .order__side {
    display: grid;
    justify-items: end;
    gap: 0.4rem;
  }

  .order__total {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .chip-status {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    white-space: nowrap;
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .chip-status--delivered {
    background: rgb(47 107 82 / 0.1);
    color: var(--success);
  }

  .chip-status--review,
  .chip-status--refunded {
    background: var(--paper-deep);
    color: var(--ink-soft);
  }

  .order__track {
    display: flex;
    gap: 0.25rem;
  }

  .order__dot {
    width: 0.9rem;
    height: 0.2rem;
    border-radius: 999px;
    background: var(--line-strong);
  }

  .order__dot.is-on {
    background: var(--accent-deep);
  }

  @media (max-width: 34rem) {
    .order {
      grid-template-columns: auto 1fr;
    }

    .order__side {
      grid-column: 1 / -1;
      grid-template-columns: auto 1fr auto;
      justify-items: start;
      align-items: center;
    }

    .order__track {
      justify-self: end;
    }
  }

  .orders__empty {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 2rem;
    background: var(--sheet);
    box-shadow: var(--shadow-art);
  }

  .orders__empty .display {
    margin: 0;
    font-size: 2rem;
  }

  .orders__empty p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 30rem;
  }

  /* ——— Profile card ——— */
  .card {
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem;
    background:
      radial-gradient(ellipse at 30% 20%, #e5cfa9, transparent 70%),
      #dcc39b;
    box-shadow: var(--shadow-art);
    rotate: 0.8deg;
    color: #2f2617;
  }

  .card .account__h2 {
    color: #2f2617;
  }

  .card__list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 1.25rem;
    background: #fdfcf8;
    box-shadow: 0 2px 6px rgb(22 23 26 / 0.12);
    rotate: -1deg;
  }

  .card__list dt {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card__list dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .card__list address {
    font-style: normal;
  }

  .card .muted {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-style: italic;
  }

  .mono {
    font-family: var(--font-body);
    letter-spacing: 0.06em;
  }

  .card .btn--ghost {
    border-color: rgb(47 38 23 / 0.4);
    color: #2f2617;
  }

  .card .btn--ghost:hover {
    background: #fdfcf8;
  }

  .card__out {
    margin: 0;
  }

  .text-button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: #2f2617;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
</style>
