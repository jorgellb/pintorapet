# Public site
PUBLIC_SITE_URL=http://localhost:4321
SITE_URL=http://localhost:4321

# Supabase
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Payments: connect Stripe and PayPal from Admin → Ajustes → Cobros.
# These variables are a fallback; keys saved in the dashboard take priority.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# test (sandbox) or live
PAYPAL_MODE=test
PAYPAL_WEBHOOK_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Pets Drawings <orders@petsdrawings.com>"
EMAIL_ADMIN=info@petsdrawings.com

# Commerce
CHECKOUT_QUOTE_TTL_SECONDS=300
CHECKOUT_RESERVATION_MINUTES=35
CART_MAX_QTY_PER_LINE=20
CART_MAX_LINES=20
CART_MAX_UNITS=40

# Admin bootstrap (script only; never a default password)
ADMIN_BOOTSTRAP_EMAIL=

# Cron / internal jobs
CRON_SECRET=

# Catalog sync — Google Merchant Center (Content API) and Meta catalog
# Google: a refresh token with the content scope, from a user added to the Merchant account.
GOOGLE_MERCHANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Meta: system-user token with catalog_management, plus the catalog id.
META_CATALOG_ID=
META_CATALOG_TOKEN=

# Anti-bot protection (all optional). ANTIBOT_SECRET signs the form challenges;
# without it a key is derived from SUPABASE_SERVICE_ROLE_KEY.
ANTIBOT_SECRET=
# Cloudflare Turnstile on top of the built-in checks: set both to turn it on.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
